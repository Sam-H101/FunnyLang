// test_chess.funny — the rules, the engine, and a whole game.
//
// `funny test extensive_examples` runs this. Four parts, each able to fail on
// its own:
//
//   1. the rules, from positions set up by hand
//   2. perft, the standard move-generation count
//   3. the engine, choosing from fixed positions at fixed depths -- including
//      that splitting the search across real threads picks the same move
//   4. a complete game, engine against engine, asserted move for move
//
// PERFT IS THE ONE THAT MATTERS. Counting the leaf nodes reachable in exactly
// N moves gives a single number that every correct chess program agrees on, and
// it is sensitive to precisely the rules that are easy to get wrong: a castling
// case, an en passant, a promotion counted once instead of four times, a move
// that leaves the king in check. Tests written by hand find the bugs you
// thought of. Perft finds the ones you did not.
//
// The last part is only possible because the engine is deterministic: moves are
// searched in sorted order and a move must be strictly better to displace the
// one already found, so the same position always produces the same move. A
// golden that played a whole game against a tie-breaking coin could assert
// nothing.
//
// No sockets anywhere. The server is a thin wrapper around these modules, and
// what a wrapper is worth testing for is that it wraps -- not the rules of
// chess, which are here.

gimme yapper

gimme { WHITE, BLACK, new_board, from_fen, to_fen, legal_moves, apply_move,
        outcome, render, find_move, in_check, attacked_by, king_square,
        count_material, position_key, position_hash, rank_of, file_of,
        square_at, square_name, square_index } from "rules.funny"
gimme { best_move, best_move_parallel, hands_for, evaluate, play_one, DEPTHS,
        VALUES, PARALLEL_FROM } from "engine.funny"

bet notations(moves) {
    yo out = []
    grind m in moves {
        out.yeet_in(m["notation"])
    }
    bounce out
}

// Just the moves of the piece on one square, when the whole list would be
// noise. Most of what follows is asserted this way.
bet moves_of(fen, src) {
    yo out = []
    grind m in legal_moves(from_fen(fen)) {
        sus (m["from"] == square_index(src)) {
            out.yeet_in(m["notation"])
        }
    }
    bounce out
}

// The position after one named move, which is how a rule's *effect* is
// asserted rather than just its availability.
bet after(fen, notation) {
    yo pos = from_fen(fen)
    bounce apply_move(pos, find_move(legal_moves(pos), notation))
}

// -- part one: the rules -----------------------------------------------------------

yap "-- the board --"
yo start = new_board()
yap render(start)
yap "white to play:", to_yap(notations(legal_moves(start)))
yap "and it is written back as:", to_fen(start)

yap "-- squares are numbered the way the board is written --"
grind name in ["a1", "h1", "e4", "d5", "a8", "h8"] {
    yo n = square_index(name)
    yap "  " + name + " is " + to_yap(n) + ": rank " + to_yap(rank_of(n)) +
        " file " + to_yap(file_of(n)) + ", and back again " +
        square_name(square_at(rank_of(n), file_of(n)))
}
yap "  off the board is -1:", square_at(-1, 0), square_at(8, 0), square_at(0, 8)

yap "-- a position read from FEN is written back unchanged --"
grind fen in ["rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
              "r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1",
              "8/8/8/3pP3/8/8/8/K6k w - d6 0 1",
              "8/P7/8/8/8/8/8/K6k w - - 0 1"] {
    yap "  " + (to_fen(from_fen(fen)) == fen ? "same" : "CHANGED") + ": " + to_fen(from_fen(fen))
}

yap "-- castling --"
// Both rooks home, nothing in between, nothing attacking the road.
yap "  both ways:", to_yap(moves_of("r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1", "e1"))
// A knight on b1 stands in the way of the long castle and nothing else.
yap "  blocked on the queen's side:", to_yap(moves_of("r3k2r/8/8/8/8/8/8/RN2K2R w KQkq - 0 1", "e1"))
// A rook on e8 checks the king, and you may not castle out of check.
yap "  not out of check:", to_yap(moves_of("4r3/8/8/8/8/8/8/R3K2R w KQ - 0 1", "e1"))
// A rook on f8 attacks f1, the square the king would cross.
yap "  not through an attacked square:", to_yap(moves_of("5r2/8/8/8/8/8/8/R3K2R w KQ - 0 1", "e1"))
// The right is gone, so only the king's own steps remain.
yap "  not without the right:", to_yap(moves_of("r3k2r/8/8/8/8/8/8/R3K2R w - - 0 1", "e1"))

yap "-- castling moves the rook too --"
yap "  after e1g1:", to_fen(after("r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1", "e1g1"))
yap "  after e1c1:", to_fen(after("r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1", "e1c1"))

yap "-- moving the king gives up both rights, moving a rook gives up one --"
yap "  king to e2:", to_fen(after("r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1", "e1e2"))
yap "  rook to h2:", to_fen(after("r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1", "h1h2"))

yap "-- en passant --"
// A black pawn has just come two squares; the white pawn on e5 may take it,
// and only now.
yap "  the pawn may take it:", to_yap(moves_of("8/8/8/3pP3/8/8/8/K6k w - d6 0 1", "e5"))
yap "  and the taken pawn is not on the square landed on:",
    to_fen(after("8/8/8/3pP3/8/8/8/K6k w - d6 0 1", "e5d6"))
yap "  a move later it is gone:", to_yap(moves_of("8/8/8/3pP3/8/8/8/K6k w - - 0 1", "e5"))

yap "-- a double pawn move offers the square, and only for one move --"
yo doubled = after("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1", "e2e4")
yap "  after e2e4:", to_fen(doubled)
yap "  and after a reply:", to_fen(apply_move(doubled, find_move(legal_moves(doubled), "b8c6")))

yap "-- promotion is four moves, not one --"
yap "  a pawn on a7:", to_yap(moves_of("8/P7/8/8/8/8/8/K6k w - - 0 1", "a7"))
yap "  a7a8q gives:", to_fen(after("8/P7/8/8/8/8/8/K6k w - - 0 1", "a7a8q"))
yap "  a7a8n gives:", to_fen(after("8/P7/8/8/8/8/8/K6k w - - 0 1", "a7a8n"))
// A capture onto the last rank promotes as well, so that is four moves too.
yap "  taking onto the last rank:", to_yap(moves_of("1n6/P7/8/8/8/8/8/K6k w - - 0 1", "a7"))

yap "-- a pinned piece may not move --"
// The knight on e2 is all that stands between the king on e1 and the rook on
// e8. It may not step aside.
yap "  the knight is pinned:", to_yap(moves_of("4r3/8/8/8/8/8/4N3/4K3 w - - 0 1", "e2"))
yap "  and the king may only leave the file:", to_yap(moves_of("4r3/8/8/8/8/8/4N3/4K3 w - - 0 1", "e1"))

yap "-- check, and getting out of it --"
// The rook on e8 checks down the open file. The pawns may not move, because a
// move that leaves your own king in check is not a move at all.
deadass CHECKED = "4r3/8/8/8/8/8/3P1P2/4K3 w - - 0 1"
yap "  white is in check:", in_check(from_fen(CHECKED), WHITE)
yap "  and has only these:", to_yap(notations(legal_moves(from_fen(CHECKED))))

yap "-- checkmate --"
// Fool's mate, the shortest there is, played out from the opening.
yo mate = new_board()
grind notation in ["f2f3", "e7e5", "g2g4", "d8h4"] {
    mate = apply_move(mate, find_move(legal_moves(mate), notation))
}
yap render(mate)
yap "  in check:", in_check(mate, WHITE)
yap "  moves left:", legal_moves(mate).how_thicc()
yap "  result:", to_yap(outcome(mate, ghost))

yap "-- stalemate is not checkmate --"
yo stale = from_fen("7k/5Q2/6K1/8/8/8/8/8 b - - 0 1")
yap "  in check:", in_check(stale, BLACK)
yap "  moves left:", legal_moves(stale).how_thicc()
yap "  result:", to_yap(outcome(stale, ghost))

yap "-- the drawn endings --"
yap "  bare kings:", to_yap(outcome(from_fen("8/8/8/4k3/8/8/8/K7 w - - 0 1"), ghost))
yap "  king and bishop:", to_yap(outcome(from_fen("8/8/8/4k3/8/8/8/KB6 w - - 0 1"), ghost))
yap "  king and knight:", to_yap(outcome(from_fen("8/8/8/4k3/8/8/8/KN6 w - - 0 1"), ghost))
yap "  king and rook is not:", to_yap(outcome(from_fen("8/8/8/4k3/8/8/8/KR6 w - - 0 1"), ghost))
yap "  fifty quiet moves:", to_yap(outcome(from_fen("8/8/8/4k3/8/8/8/KR6 w - - 100 1"), ghost))

yap "-- the same position three times is a draw --"
yo repeated = from_fen("8/8/8/4k3/8/8/8/KR6 w - - 0 1")
yo thrice = {}
thrice[position_key(repeated)] = 3
yo twice = {}
twice[position_key(repeated)] = 2
yap "  seen three times:", to_yap(outcome(repeated, thrice))
yap "  seen twice:", to_yap(outcome(repeated, twice))

yap "-- what attacks what --"
// Reverse attack detection: ask of a square, rather than of every piece in turn.
yo board = from_fen("8/8/8/3q4/8/8/8/K6k w - - 0 1")
yap "  the queen on d5 attacks d1:", attacked_by(board["squares"], square_index("d1"), BLACK)
yap "  and h1:", attacked_by(board["squares"], square_index("h1"), BLACK)
yap "  but not b2:", attacked_by(board["squares"], square_index("b2"), BLACK)
// h2 is not on any line from d5 -- it is the black king on h1 that covers it,
// which is the point of asking about a square rather than about a piece.
yap "  h2 is covered by the black king though:", attacked_by(board["squares"], square_index("h2"), BLACK)
yap "  the white king is at:", square_name(king_square(board["squares"], WHITE))

yap "-- a carried hash matches one worked out from scratch --"
// `apply_move` carries the position hash forward by XORing out what left and
// XORing in what arrived, instead of walking the board again. Every single
// mutation has to be mirrored: the capture, the pawn taken in passing that is
// not on the square landed on, the rook that moves when the king castles, the
// promotion, each castling right given up, the en-passant square opening and
// closing again, and the side to move.
//
// Miss one and nothing breaks loudly -- the transposition table simply starts
// answering for a position that is not the one being asked about. So rather
// than wait for that to surface as a wrong move somewhere, every legal move
// from each of these positions is made and the carried hash is compared
// against an honest one. The positions are chosen to reach every case above.
deadass HASH_CASES = [
    "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
    "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1",
    "8/8/8/3pP3/8/8/8/K6k w - d6 0 1",
    "1n6/P7/8/8/8/8/8/K6k w - - 0 1",
    "r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1",
]
yo hash_checks = 0
yo hash_drifted = 0
grind fen in HASH_CASES {
    yo p = from_fen(fen)
    hash_checks += 1
    sus (p["hash"] != position_hash(p)) {
        hash_drifted += 1
    }
    grind m in legal_moves(p) {
        yo after = apply_move(p, m)
        hash_checks += 1
        sus (after["hash"] != position_hash(after)) {
            hash_drifted += 1
        }
    }
}
yap "  hashes checked:", hash_checks
yap "  that drifted:", hash_drifted

// -- part two: perft ---------------------------------------------------------------

bet perft(pos, depth) {
    sus (depth == 0) {
        bounce 1
    }
    yo moves = legal_moves(pos)
    sus (depth == 1) {
        bounce moves.how_thicc()
    }
    yo total = 0
    grind m in moves {
        total += perft(apply_move(pos, m), depth - 1)
    }
    bounce total
}

yap "-- perft, from the opening --"
// Depth 3 here rather than 4: depth 4 is 197,281 positions and nine seconds,
// which is a long time to spend in CI on a number the position below tests far
// more sharply. The README says how to run it deeper.
grind pair in [[1, 20], [2, 400], [3, 8902]] {
    yo got = perft(new_board(), pair[0])
    yap "  depth " + to_yap(pair[0]) + ": " + to_yap(got) +
        (got == pair[1] ? " ok" : " WRONG, wanted " + to_yap(pair[1]))
}

yap "-- perft, from a position full of the awkward moves --"
// Castling both ways for both sides, pawns that can take en passant, and pawns
// one square from promoting. This position exists precisely because the opening
// exercises none of that, and its counts are published too.
deadass TRICKY = "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1"
grind pair in [[1, 48], [2, 2039]] {
    yo got = perft(from_fen(TRICKY), pair[0])
    yap "  depth " + to_yap(pair[0]) + ": " + to_yap(got) +
        (got == pair[1] ? " ok" : " WRONG, wanted " + to_yap(pair[1]))
}

// -- part three: the engine ----------------------------------------------------------

yap "-- the engine picks the same move every time --"
// Not merely the same move: the same score, and the same number of positions
// looked at getting there. That is the stronger claim, and it is the one the
// pondering in serve.funny rests on -- a reply worked out before it was asked
// for is only interchangeable with one worked out on demand if `best_move` is
// a function of the position and of nothing else.
//
// The way that would break is somebody keeping the transposition table between
// calls to find more hits. The move would probably stay the same and the count
// would not, so the count is what is asserted here.
grind depth in [1, 2, 3] {
    yo first = best_move(new_board(), depth)
    yo again = best_move(new_board(), depth)
    yo same = first["score"] == again["score"] && first["nodes"] == again["nodes"]
    yap "  depth " + to_yap(depth) + ": " + first["move"]["notation"] +
        " (score " + to_yap(first["score"]) + ", " + to_yap(first["nodes"]) + " positions)" +
        ", and again: " + again["move"]["notation"] +
        ", same score and count: " + to_yap(same)
}

yap "-- it finds mate in one --"
// A back-rank mate: the rook drops to a8 and the king has no square, because
// its own pawns are in the way.
deadass BACK_RANK = "6k1/5ppp/8/8/8/8/8/R3K3 w Q - 0 1"
yo mate_in_one = best_move(from_fen(BACK_RANK), 2)
yap "  it plays:", mate_in_one["move"]["notation"]
yap "  and that is mate:",
    to_yap(outcome(apply_move(from_fen(BACK_RANK), mate_in_one["move"]), ghost))

yap "-- it takes the free queen --"
// A black queen on d5 defended by nothing, and a white knight able to take it.
yo free_queen = best_move(from_fen("4k3/8/8/3q4/8/4N3/8/4K3 w - - 0 1"), 2)
yap "  it plays:", free_queen["move"]["notation"]

yap "-- it deals with the threat to its own queen --"
// The pawn on c5 attacks the white queen on d4. Moving away would do; taking
// the pawn is better, and the engine can see that at depth 2.
yo save_it = best_move(from_fen("4k3/8/8/2p5/3Q4/8/8/4K3 w - - 0 1"), 2)
yap "  from d4 it plays:", save_it["move"]["notation"]

yap "-- the same answer, split across real threads --"
// The root split deals most of the moves out to workers on OS threads. Whether
// it is worth doing depends on the depth, and `hands_for` decides that -- but
// whatever it decides, the answer may not change: the same move and the same
// score, every time. That is the guarantee.
//
// The number of positions looked at is deliberately *not* part of it. The
// parent searches the best-ordered move itself and hands the resulting alpha
// to every worker, which is what stops the count exploding -- without it the
// workers search with the window wide open and it was thirteen times higher at
// depth 4. But equal it is not, for two reasons that both cut the same way:
// each worker is a separate VM with its own fresh transposition table, so none
// of them can reuse what the others have worked out, where one thread fills a
// single table and reads it back all search long; and a worker whose slice
// does not contain the best move never gets to narrow its own alpha the way a
// sequential search narrows its own.
grind fen in [TRICKY, BACK_RANK] {
    yo p = from_fen(fen)
    yo one = best_move(p, 3)
    yo many = best_move_parallel(p, 3, 4)
    yap "  " + one["move"]["notation"] +
        ": same move " + to_yap(one["move"]["notation"] == many["move"]["notation"]) +
        ", same score " + to_yap(one["score"] == many["score"]) +
        ", same positions " + to_yap(one["nodes"] == many["nodes"])
}
yap "  threads start at depth:", PARALLEL_FROM
// Printed as a count below the threshold and as a yes-or-no above it, because
// above it the answer is the machine's processor count and a golden may not
// depend on how many the machine running it happens to have.
yap "  below that it asks for", hands_for(30, PARALLEL_FROM - 1), "worker"
yap "  at it, for more than one:", hands_for(30, PARALLEL_FROM) > 1
yap "  and with nothing worth dealing out,", hands_for(2, PARALLEL_FROM), "worker"

yap "-- what it makes of a position --"
yap "  even start:", evaluate(new_board(), WHITE)
yo up_a_rook = from_fen("4k3/8/8/8/8/8/8/R3K3 w - - 0 1")
yap "  a rook ahead:", evaluate(up_a_rook, WHITE) > VALUES["R"] - 100
yap "  and from the other side:", evaluate(up_a_rook, BLACK) < -(VALUES["R"] - 100)
yap "  the difficulties:", to_yap(DEPTHS["easy"]), to_yap(DEPTHS["normal"]), to_yap(DEPTHS["hard"])

// -- part four: a whole game --------------------------------------------------------

yap "-- the engine against itself --"
// Depth 2 for both sides, and a cap on the length: deep enough to be a real
// game, shallow and short enough that this runs in a golden on every platform
// CI builds.
yo game = new_board()
yo played = []
yo nodes = 0
yo positions = {}
positions[position_key(game)] = 1
bruh (outcome(game, positions) == ghost && game["moves"] < 40) {
    yo turn = play_one(game, 2)
    sus (turn["move"] == ghost) {
        bail
    }
    played.yeet_in(turn["move"]["notation"])
    nodes += turn["nodes"]
    game = turn["pos"]
    yo key = position_key(game)
    positions[key] = positions.get(key, 0) + 1
}

yap "moves played:", played.how_thicc()
yap "positions looked at:", nodes > 0
grind i from 0 to played.how_thicc() {
    sus (i % 8 == 0) {
        yo line = []
        grind k from i to (i + 8 < played.how_thicc() ? i + 8 : played.how_thicc()) {
            line.yeet_in(played[k])
        }
        yap "  " + yapper.pad_left(to_yap(i + 1), 3) + ". " + line.join("  ")
    }
}
yap "result:", to_yap(outcome(game, positions))
yap "white left:", to_yap(count_material(game, WHITE)),
    "black left:", to_yap(count_material(game, BLACK))
yap render(game)
yap "-- done --"
