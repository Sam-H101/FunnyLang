// test_grab.funny — the client, the tags, the names, and the whole pipeline.
//
// `funny test extensive_examples` runs this, and CI runs that with
// FUNNY_NO_NET=1. Nothing here reaches further than 127.0.0.1, and nothing
// here knows Suno's real hostnames: the fixture server in `fixture.funny`
// serves the *shapes* PLAN.md §10 D1 measured from the real site, with
// invented content.
//
// Seven parts, each able to fail on its own:
//
//   1. URLs, with no socket in sight
//   2. the HTTP client against ten response shapes
//   3. resolving a share link the way the real one is laid out
//   4. ID3v2.3, written and read back
//   5. MP4 tags, written into a real box tree
//   6. filenames that survive being copied to another computer
//   7. the whole pipeline, one song and then four at once
//
// WHY THE FIXTURE IS THE WORKER AND THE CLIENT IS THE MAIN THREAD. The client
// blocks on its reads by design (`fetch.funny` says why), so it cannot share a
// thread with a server parked in `accept`. `kv/test_kv.funny` puts the server
// on the main thread because the server is what it is testing; here the client
// is, so they swap.

gimme filez
gimme blob
gimme yapper
gimme interns
gimme json

gimme { parse_url, resolve_url, get, probe, get_to_file, request, USER_AGENT } from "fetch.funny"
// Whole modules rather than named imports: `write_tags` and `read_tags` exist
// in both taggers, and which one runs is the point of part five.
gimme "suno.funny"
gimme "id3.funny"
gimme "mp4tags.funny"
gimme "namer.funny"

yo HERE = filez.dir_of(the_script())
yo ID = "11111111-2222-3333-4444-555555555555"

// -- part one: URLs ---------------------------------------------------------------------

yap "-- urls --"

bet show(url) {
    yo u = parse_url(url)
    yo shown = what_is_it(url) == "yapstring" ? url : to_yap(url) + " (a " + what_is_it(url) + ")"
    sus (u == ghost) {
        yap "  " + shown + "  ->  not a url"
        bounce ghost
    }
    yap "  " + shown + "  ->  " + u["scheme"] + " " + u["host"] + " :" + to_yap(u["port"]) +
        " " + u["path"] + (u["query"] == "" ? "" : " ?" + u["query"]) + "  = " + u["url"]
}

grind url in ["https://suno.com/song/abc",
              "http://example.com",
              "https://example.com:8443/a/b?c=d&e=f",
              "http://127.0.0.1:9/",
              "https://user:pw@example.com/secret",
              "https://[::1]:8080/v6",
              "https://[::1]/v6",
              "https://example.com/path#fragment",
              "https://example.com/?only=query"] {
    show(url)
}

yap "  -- and the ones that are not urls --"
grind url in ["", "suno.com/song/abc", "ftp://example.com/x", "https://", "://nope",
              "https://example.com:99999/", "https://example.com:0/", 42] {
    show(url)
}

yap "  -- relative Locations --"
yo base = parse_url("https://example.com/a/b/c?x=1")
grind loc in ["/root", "sibling", "../up", "https://other.example/abs", "//other.example/scheme",
              "?just=query", ghost] {
    yo out = resolve_url(base, loc)
    yap "  " + to_yap(loc) + "  ->  " + (out == ghost ? "nothing" : out["url"])
}

// -- the fixture ---------------------------------------------------------------------------

yap "-- the client --"

yo server = interns.hire(filez.join_path(HERE, "fixture.funny"), {"id": ID})
yo hello = interns.wait_up(interns.check_dms(10000))
no_cap(hello != ghost, "the fixture never said which port it took")
yo PORT = hello["msg"]["port"]
yo BASE = "http://127.0.0.1:" + to_yap(PORT)

bet fetch_text(path, opts) {
    yo r = get(BASE + path, opts)
    bounce r
}

bet report(label, r) {
    yap "  " + label + ": " + to_yap(r["status"]) + "  " + to_yap(how_thicc(r["blob"])) +
        " bytes  " + to_yap(r["body"])
}

report("a plain Content-Length body", fetch_text("/plain", ghost))
report("a chunked body, split mid-header", fetch_text("/chunked", ghost))
report("a body delimited by the close", fetch_text("/until-close", ghost))
report("headers arriving in two reads", fetch_text("/slow-headers", ghost))
report("a root-relative redirect", fetch_text("/redirect/root", ghost))
report("a directory-relative redirect", fetch_text("/redirect/dir", ghost))
report("an absolute redirect", fetch_text("/redirect/absolute", ghost))
report("a chain of three", fetch_text("/redirect/chain/3", ghost))
report("a 503 that recovers", fetch_text("/flaky", ghost))
report("a 404 is an answer, not an error", fetch_text("/notfound", ghost))

yap "  -- and the ones that must fail --"
bet must_fail(label, f) {
    sketchy {
        f()
        yap "  " + label + ": NO ERROR, which is wrong"
    } my_bad (e) {
        yap "  " + label + ": " + e.flavor + " -- " + e.message
    }
}
must_fail("a redirect loop", lowkey () => fetch_text("/redirect/loop", {"max_redirects": 3}))
must_fail("a reply that is not HTTP", lowkey () => fetch_text("/teapot-headers", ghost))
must_fail("a body past the ceiling", lowkey () => fetch_text("/song.mp3", {"max_bytes": 100}))
must_fail("nothing said at all", lowkey () => fetch_text("/no-reply", {"retries": 0}))
must_fail("a port with nobody on it", lowkey () => get("http://127.0.0.1:1/", {"retries": 0}))

yap "  -- hops are recorded --"
yo chained = fetch_text("/redirect/chain/3", ghost)
yap "  followed: " + to_yap(how_thicc(chained["hops"])) + " hops, ending at " +
    yapper.replace(chained["url"], BASE, "<base>")

yap "  -- one byte, to size a file without fetching it --"
yo sized = probe(BASE + "/ranged", ghost)
yap "  probe: " + to_yap(sized["status"]) + " size=" + to_yap(sized["size"])

// -- downloads --------------------------------------------------------------------------

yap "-- downloads --"

yo TMP = filez.temp_file("sunograb") + "_dir"
filez.mkdir(TMP)

bet wipe(dir) {
    sus (filez.is_dir(dir)) {
        grind name in filez.list_dir(dir) {
            yo p = filez.join_path(dir, name)
            sus (filez.is_file(p)) { filez.obliterate(p) }
        }
    }
}

yo whole_path = filez.join_path(TMP, "whole.mp3")
yo whole = get_to_file(BASE + "/ranged", whole_path, ghost)
yap "  a whole file: " + to_yap(whole["bytes"]) + " bytes, resumed=" + to_yap(whole["resumed"])
yo whole_bytes = filez.read_blob(whole_path)
yap "  it is on disk: " + to_yap(how_thicc(whole_bytes)) + " bytes, starts with an mp3 frame: " +
    to_yap(whole_bytes.starts_with(blob.of([0xFF, 0xFB])))
yap "  no .part left behind: " + to_yap(!filez.exists(whole_path + ".part"))

// The truncating route closes at 40% of a body it promised in full. The first
// attempt fails; `--resume`'s machinery then asks for the rest with a Range
// and the finished file must be byte-identical to the one fetched in one go.
yap "  -- interrupted, then resumed --"
yo part_path = filez.join_path(TMP, "resumed.mp3")
must_fail("the interrupted download", lowkey () =>
    get_to_file(BASE + "/truncates", part_path, {"retries": 0, "resume": fax}))
yo left_over = filez.exists(part_path + ".part") ? how_thicc(filez.read_blob(part_path + ".part")) : 0
yap "  the .part survived with " + to_yap(left_over) + " of " + to_yap(how_thicc(whole_bytes)) + " bytes"
yo finished = get_to_file(BASE + "/truncates", part_path, {"resume": fax})
yap "  resumed: " + to_yap(finished["bytes"]) + " bytes, resumed=" + to_yap(finished["resumed"])
yap "  identical to the whole one: " + to_yap(filez.read_blob(part_path) == whole_bytes)

// A server that answers a Range with 200 has ignored it. Appending would weld
// two halves together into a file of the right length and the wrong bytes.
yap "  -- a server that ignores the Range --"
yo ignored_path = filez.join_path(TMP, "ignored.mp3")
filez.write_blob(ignored_path + ".part", whole_bytes[0:100])
yo ignored = get_to_file(BASE + "/ignores-range", ignored_path, {"resume": fax})
yap "  restarted rather than appended: " + to_yap(ignored["bytes"]) + " bytes, identical: " +
    to_yap(filez.read_blob(ignored_path) == whole_bytes)

yap "  -- progress is reported --"
yo ticks = []
get_to_file(BASE + "/ranged", filez.join_path(TMP, "progress.mp3"),
            {"on_progress": lowkey (done, total) => ticks.yeet_in(done)})
yap "  the last progress call saw every byte: " + to_yap(ticks[how_thicc(ticks) - 1] == how_thicc(whole_bytes))

// -- part three: resolving a share link -------------------------------------------------
//
// Every host the resolver would reach is pointed at the fixture, which serves
// the *shapes* §10 D1 measured: a page with no `og:audio`, an embedded record
// whose `audio_url` is the forbidden marker, and a clip API that answers
// unauthenticated with `media_urls`.

yap "-- resolving --"

yo AT_FIXTURE = {"api_base": BASE, "page_base": BASE, "cdn_base": BASE,
                 "allow_hosts": ["127.0.0.1"]}

bet describe(record) {
    yap "  title:      " + record["title"]
    yap "  artist:     " + record["artist"] + " (@" + record["handle"] + ")"
    yap "  tags:       " + record["tags"]
    yap "  created:    " + record["created"] + "   model: " + record["model"]
    yap "  cover:      " + to_yap(at_base(record["image_url"]))
    yap "  via:        " + record["via"] + "   (the id came from: " + record["id_via"] + ")"
    yo kinds = []
    grind r in record["renditions"] { kinds.yeet_in(r["kind"] + " <- " + r["content_type"]) }
    yap "  renditions: " + to_yap(kinds)
}

bet at_base(url) {
    sus (url == ghost) { bounce ghost }
    bounce yapper.replace(url, BASE, "<base>")
}

yap "  -- a full song link --"
yo record = suno.resolve(BASE + "/song/" + ID, AT_FIXTURE)
describe(record)

yap "  -- a short share link, whose page has to be read for the id --"
yo short = suno.resolve(BASE + "/s/shortcode", AT_FIXTURE)
yap "  same song: " + to_yap(short["id"] == ID) + ", id came from: " + short["id_via"]

yap "  -- choosing a rendition --"
yo chosen = suno.choose(record.clone(), "m4a", AT_FIXTURE)
yap "  m4a:  " + at_base(chosen["audio_url"]) + "  (" + chosen["audio_kind"] + ")"
yo as_video = suno.choose(record.clone(), "mp4", AT_FIXTURE)
yap "  mp4:  " + at_base(as_video["audio_url"]) + "  (" + as_video["audio_kind"] + ")"
yo best = suno.choose(record.clone(), "best", AT_FIXTURE)
yap "  best: " + at_base(best["audio_url"]) + "  (" + best["audio_kind"] + ")"

// The sentence that matters most in this whole example: there is no public
// mp3, and the program says so plainly rather than writing an Opus stream
// into a file called .mp3.
must_fail("  asking for an mp3", lowkey () => suno.choose(record.clone(), "mp3", AT_FIXTURE))

yap "  -- the tags it hands the tagger --"
yo song_tags = suno.tags_for(record)
grind key in ["title", "artist", "album", "year", "genre", "comment"] {
    yap "    " + key + ": " + to_yap(song_tags[key])
}
yap "    extra: " + to_yap(song_tags["extra"])
// The clip record's `prompt` field holds the whole lyric on a real song. A
// downloader saves the file; it does not copy somebody's words into a comment
// frame they never asked for.
yap "    no lyric field anywhere in the tags: " +
    to_yap(!song_tags.has("prompt") && !yapper.contains(to_yap(song_tags), "prompt"))

yap "  -- when the API is unreachable, the page and the pattern answer --"
yo no_api = AT_FIXTURE.clone()
no_api["api_base"] = "http://127.0.0.1:1"
no_api["retries"] = 0
yo degraded = suno.resolve(BASE + "/song/" + ID, no_api)
yap "  title from the meta tags: " + degraded["title"]
yap "  audio from the pattern:   " + at_base(degraded["audio_url"]) + "  (" +
    to_yap(degraded["audio_kind"]) + ", " + to_yap(degraded["size"]) + " bytes)"
yap "  via: " + degraded["via"] + "  -- which is the sign the rungs above it need a look"

yap "  -- and the ones that must fail --"
must_fail("  a deleted song", lowkey () =>
    suno.resolve(BASE + "/song/00000000-0000-0000-0000-000000000000", AT_FIXTURE))
must_fail("  not a link at all", lowkey () => suno.resolve("", AT_FIXTURE))
must_fail("  audio on a host we do not follow", lowkey () =>
    suno.choose(record.clone(), "m4a", {"allow_hosts": ["suno.ai"]}))

// -- part four: ID3v2.3 ------------------------------------------------------------------

yap "-- id3 --"

yo mp3 = get(BASE + "/song.mp3", ghost)["blob"]
yo cover = get(BASE + "/cover.jpg", ghost)["blob"]
yap "  an mp3 of " + to_yap(how_thicc(mp3)) + " bytes and a cover of " +
    to_yap(how_thicc(cover)) + " bytes"

// A title and an artist that ISO-8859-1 could not hold, which is why the text
// frames are UTF-16 and not Latin-1.
yo TAGS = {"title": "Nach\u{00FC}rlich \u{2014} caf\u{00E9} \u{1F3B8}",
           "artist": "\u{0141}ukasz & the \u{00C6}ons",
           "album": "Suno", "year": "2026", "genre": "test tone, loopback",
           "comment": "grabbed by the example", "url": "https://example.invalid/song/abc",
           "cover": cover, "cover_mime": "image/jpeg",
           "extra": {"SUNO_ID": ID, "SUNO_MODEL": "chirp-fixture"}}

yo tagged = id3.write_tags(mp3, TAGS)
yap "  tagged file grew by " + to_yap(how_thicc(tagged) - how_thicc(mp3)) + " bytes"

// The four header bytes, asserted against what they must be rather than
// against the reader in the same file. A syncsafe size is the one field whose
// being wrong breaks nothing loudly.
yo tag_size = how_thicc(tagged) - how_thicc(mp3) - 10
yap "  the header says ID3v2." + to_yap(tagged[3]) + "." + to_yap(tagged[4])
yap "  its size field is syncsafe: " + to_yap(tagged[6:10].to_hex()) +
    " for " + to_yap(tag_size) + " bytes"
no_cap(tagged[6] < 128 && tagged[7] < 128 && tagged[8] < 128 && tagged[9] < 128,
       "a syncsafe size must have the top bit of every byte clear")
no_cap(((tagged[6] & 0x7F) << 21) | ((tagged[7] & 0x7F) << 14) |
       ((tagged[8] & 0x7F) << 7) | (tagged[9] & 0x7F) == tag_size,
       "the syncsafe size does not decode to the tag's real length")

yo back = id3.read_tags(tagged)
yap "  version: " + back["version"]
grind name in ["TIT2", "TPE1", "TALB", "TYER", "TCON", "COMM", "WOAF"] {
    yap "    " + name + ": " + to_yap(back["frames"].get(name, "<missing>"))
}
grind name in back["extra"].keys() {
    yap "    TXXX " + name + ": " + back["extra"][name]
}
yap "  the cover came back: " + to_yap(back["cover"]["mime"]) + ", " +
    to_yap(how_thicc(back["cover"]["bytes"])) + " bytes, byte-identical: " +
    to_yap(back["cover"]["bytes"] == cover)

yap "  the audio is untouched: " + to_yap(id3.strip_tags(tagged) == mp3)

// Writing twice must replace, not stack. A tagger that prepends leaves the
// first tag in place and the file keeps its old title forever.
yo twice = id3.write_tags(tagged, {"title": "the second title"})
yap "  tagging twice replaces: " + to_yap(id3.read_tags(twice)["frames"]["TIT2"]) +
    ", still one tag: " + to_yap(id3.strip_tags(twice) == mp3)

yap "  an untagged file has no tags: " + to_yap(id3.read_tags(mp3) == ghost)

// -- part five: the MP4 box tree ---------------------------------------------------------

yap "-- mp4 tags --"

yo m4a = get(BASE + "/1/clip/" + ID + ".m4a", ghost)["blob"]
yap "  an m4a of " + to_yap(how_thicc(m4a)) + " bytes"
yo before = mp4tags.read_tags(m4a)
yap "  it already had a title: " + to_yap(before["tags"].get("\u{00A9}nam", "<none>"))
yo offsets_before = mp4tags.chunk_offsets(m4a)
yap "  its chunk offsets: " + to_yap(offsets_before)

yo m4a_tagged = mp4tags.write_tags(m4a, TAGS)
yo grew = how_thicc(m4a_tagged) - how_thicc(m4a)
yap "  tagged file grew by " + to_yap(grew) + " bytes"

yo after = mp4tags.read_tags(m4a_tagged)
grind name in after["tags"].keys() {
    yap "    " + name + ": " + after["tags"][name]
}
yap "  the cover came back: " + to_yap(after["cover"]["mime"]) + ", byte-identical: " +
    to_yap(after["cover"]["bytes"] == cover)

// THE ASSERTION THAT MATTERS. `moov` grew, so `mdat` moved down the file by
// exactly that much, so every chunk offset must have moved with it. A tagger
// that skips this passes every round-trip test and corrupts every real file.
yo offsets_after = mp4tags.chunk_offsets(m4a_tagged)
yap "  its chunk offsets now: " + to_yap(offsets_after)
yo all_moved = fax
grind i from 0 to how_thicc(offsets_before) {
    sus (offsets_after[i] - offsets_before[i] != grew) { all_moved = cap }
}
yap "  every offset moved by exactly the amount moov grew: " + to_yap(all_moved)
no_cap(all_moved, "a chunk offset did not move with the mdat it points into")

// And the offsets must still point at the same bytes they did before.
yap "  offset 0 still points at the same byte: " +
    to_yap(m4a[offsets_before[0]] == m4a_tagged[offsets_after[0]])

yo m4a_twice = mp4tags.write_tags(m4a_tagged, {"title": "the second title"})
yap "  tagging twice replaces: " + to_yap(mp4tags.read_tags(m4a_twice)["tags"]["\u{00A9}nam"]) +
    ", and the file did not grow again: " +
    to_yap(how_thicc(m4a_twice) < how_thicc(m4a_tagged))

// -- part six: filenames -------------------------------------------------------------------

// A title with a tab or a newline in it cannot be printed as itself: the
// golden's own output would gain a line break and stop matching.
bet shown_title(t) {
    yo out = ""
    grind c in yapper.chars(t) {
        yo cp = yapper.ord_of(c)
        sus (cp == 9) { out = out + "\\t" }
        kinda_sus (cp == 10) { out = out + "\\n" }
        kinda_sus (cp < 32) { out = out + "\\x" + to_yap(cp) }
        nah { out = out + c }
    }
    bounce how_thicc(out) > 40 ? yapper.slice(out, 0, 40) + "..." : out
}

yap "-- names --"

grind title in ["Loopback Lullaby",
                "AC/DC: Back \"in\" Black?",
                "a\ttab\nand a newline",
                "trailing dots...",
                "   ",
                "NUL",
                "nul.m4a",
                "COM4",
                "\u{1F3B8}\u{1F3B8}\u{1F3B8}",
                "\u{00E9}" * 200] {
    yo safe = namer.safe_name(title, "song-" + ID)
    yap "  " + to_yap(shown_title(title)) + "  ->  " + to_yap(safe) +
        "  (" + to_yap(yapper.byte_len(safe)) + " bytes)"
    no_cap(yapper.byte_len(safe) <= 150, "a name went past the byte budget")
}

yap "  -- templates --"
yo fields = {"title": "Loopback Lullaby", "artist": "The Fixture", "id": ID,
             "date": "2026-01-02"}
grind template in ["{title}", "{artist} - {title}", "{date} {title}", "{nope} {title}"] {
    yap "  " + template + "  ->  " + namer.render(template, fields)
}

yap "  -- collisions --"
yo taken = {"/d/song.m4a": fax, "/d/song (2).m4a": fax}
yap "  " + namer.unique_path("/d", "song", ".m4a", lowkey (p) => taken.has(p))
yap "  " + namer.unique_path("/d", "other", ".m4a", lowkey (p) => taken.has(p))

interns.dm(server, "stop")
yo tally = interns.wait_up(server)
yap "  the fixture served " + to_yap(tally["served"]) + " requests"

wipe(TMP)
filez.obliterate(TMP)
yap "-- done --"
