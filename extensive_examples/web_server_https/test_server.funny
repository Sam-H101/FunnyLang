// test_server.funny — web_server_https end to end, in one program.
//
// `funny test extensive_examples` runs this. Part one checks the pure pieces,
// with no socket in sight. Part two starts the real server -- the keeper,
// four acceptor threads and the redirect listener, on ports the OS picks --
// and drives it over real TLS from client interns that trust only the
// committed test CA. Part three reads the files it left behind.
//
// Nothing printed depends on timing, on which thread served what, on port
// numbers, or on which TLS stack this platform has: Secure Transport stops at
// TLS 1.2 where OpenSSL and Schannel negotiate 1.3, so the version is checked
// as "1.2 or newer" rather than printed.

gimme filez
gimme yapper
gimme interns
gimme { sha256_hex, base64_encode, base64_decode } from "crypto.funny"
gimme json

// json.parse raises on anything that isn't JSON. A body that is not JSON is
// just a bad request, so this is the "no" answer rather than an unwind.
bet try_parse(text) {
    sketchy {
        bounce json.parse(text)
    } my_bad (e) {
        bounce ghost
    }
}
gimme { read_request, build_response } from "http.funny"
gimme { ct_equal, cookies_of, session_id_of, valid_email, password_problem, window_hit } from "security.funny"
gimme { load_config, seal, unseal, hash_password, default_config_path, custom_config_path,
        activity_path } from "store.funny"
gimme { static_target } from "static.funny"
gimme { run_server, stop_server } from "server.funny"

yo HERE = filez.dir_of(the_script())

// -- part one: the pieces ------------------------------------------------------------

yap "-- sha-256 and base64 --"
yap sha256_hex("")
yap sha256_hex("abc")
yap sha256_hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
yap base64_encode("funnylang"), base64_decode("ZnVubnlsYW5n"), base64_encode("é💀")
yap "not base64:", base64_decode("Zm9"), base64_decode("Zm=v"), base64_decode("Zm9*")

yap "-- json --"
yap json.spill(json.parse("{\"a\": [1, 2.5, -3e2, true, false, null], \"b\": \"x\\n\\u00e9\\ud83d\\ude00\"}"))
yap "refused:", try_parse("[1, 2"), try_parse("{} x"), try_parse("\"\\q\""),
    try_parse("[" * 600 + "]" * 600)

yap "-- http --"
bet parse(text) {
    yo chunks = [text]
    bounce await_fr read_request(lowkey (ms) => chunks.how_thicc() > 0 ? chunks.yoink() : "")
}
bet http_checks() {
    yo get = parse("GET /a%20b?x=1&y=%C3%A9 HTTP/1.1\r\nHost: h\r\nCookie: a=1; a=2\r\n\r\n")
    yap "request:", get["method"], get["path"], get["query"], cookies_of(get["headers"])
    yap "body:", parse("POST /x HTTP/1.1\r\nHost: h\r\nContent-Length: 5\r\n\r\nhello")["body"]
    grind pair in [
        ["no Host", "GET / HTTP/1.1\r\n\r\n"],
        ["HTTP/2.0", "GET / HTTP/2.0\r\nHost: h\r\n\r\n"],
        ["unknown method", "BREW / HTTP/1.1\r\nHost: h\r\n\r\n"],
        ["absolute target", "GET http://x/ HTTP/1.1\r\nHost: h\r\n\r\n"],
        ["chunked body", "POST / HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: chunked\r\n\r\n"],
        ["body too big", "POST / HTTP/1.1\r\nHost: h\r\nContent-Length: 70000\r\n\r\n"],
        ["two lengths", "POST / HTTP/1.1\r\nHost: h\r\nContent-Length: 1\r\nContent-Length: 2\r\n\r\nx"],
        ["folded header", "GET / HTTP/1.1\r\nHost: h\r\n X: y\r\n\r\n"],
        ["bad escape", "GET /%zz HTTP/1.1\r\nHost: h\r\n\r\n"],
        ["encoded NUL", "GET /a%00b HTTP/1.1\r\nHost: h\r\n\r\n"],
        ["request line too long", "GET /" + "a" * 9000],
        ["too many headers", "GET / HTTP/1.1\r\nHost: h\r\n" + "X: y\r\n" * 70 + "\r\n"],
        ["hung up", "GET / HT"],
    ] {
        yap pair[0] + ":", parse(pair[1])["status"]
    }
}
http_checks()
yap "a header that tries to add another:",
    yapper.contains(build_response(200, "", {"X-Evil": "a\r\nSet-Cookie: x=1"}, cap), "Set-Cookie")

yap "-- the path guard --"
grind p in ["/", "/settings", "/css/site.css", "/js/api.js", "/favicon.svg", "/../etc/passwd", "/css/../../x.css",
            "/.env", "/.git/config", "/css/", "/a\\b.css", "/c:/x.css", "/x.exe", "/%2e%2e/x.css"] {
    yo t = static_target("/web", p)
    yap p, t == ghost ? "refused" : "-> " + yapper.replace(t["file"], "\\", "/")
}

yap "-- secrets --"
yap "compare:", ct_equal("abc", "abc"), ct_equal("abc", "abd"), ct_equal("abc", "abcd"), ct_equal(ghost, "")
yap "session cookie must be a token:", session_id_of({"cookie": "__Host-sid=" + "a" * 64}) == "a" * 64,
    session_id_of({"cookie": "__Host-sid=../../etc"})
yap "email:", valid_email("a@b.co"), valid_email("a@@b.co"), valid_email("a b@c.co"), valid_email("<a>@b.co")
yap "password:", password_problem("short"), password_problem("long enough, surely")
yo windows = {}
yo hits = []
grind i from 0 to 5 {
    hits.yeet_in(window_hit(windows, "1.2.3.4", 100.0, 10, 3)["allowed"])
}
yap "three a window:", hits, window_hit(windows, "1.2.3.4", 111.0, 10, 3)["allowed"]

yap "-- data at rest, as committed --"
yo committed = load_config(default_config_path(HERE), "")
yo admin0 = committed["config"]["users"]["admin"]
yap "users:", committed["source"], committed["config"]["users"].keys()
yap "password:", yapper.slice(admin0["password"], 0, 7), admin0["password"] == hash_password("funnylang")
yap "email:", admin0["profile"]["email"], "->", unseal(admin0["profile"]["email"])
yap "seal round trip:", unseal(seal("über ✓")), seal("tester@example.com")

// -- part two: the server, over TLS -------------------------------------------------------

yap "-- the server, over TLS --"
yo DATA = filez.temp_file() + "_data"
filez.mkdir(DATA)
yo CA = filez.join_path(filez.join_path(HERE, "certs"), "ca.pem")
yo CLIENT = filez.join_path(HERE, "test_client.funny")
yo RESULTS = {}
yo DRIVING = ghost

async_ngl bet drive(info) {
    yo job = {"port": info["https_port"], "http_port": info["http_port"], "ca": CA}
    yo talk_job = job.clone()
    talk_job["script"] = "conversation"
    yo talk = interns.hire(CLIENT, talk_job)
    // Four more clients at once, ten page views each, while the conversation
    // is going on: several threads, several connections per thread.
    yo crowd = []
    grind k from 0 to 4 {
        yo crowd_job = job.clone()
        crowd_job["script"] = "views"
        crowd_job["count"] = 10
        crowd.yeet_in(interns.hire(CLIENT, crowd_job))
    }
    RESULTS["conversation"] = await_fr talk
    yo views = 0
    grind c in crowd {
        views += await_fr c
    }
    RESULTS["views"] = views
    await_fr stop_server(info)
}

bet ready(info) {
    RESULTS["threads"] = info["threads"]
    RESULTS["config"] = info["config"]
    DRIVING = drive(info)
}

yo summary = await_fr run_server(HERE, {"port": 0, "http_port": 0, "threads": 4, "data_dir": DATA, "seconds": 120},
                                 ready, lowkey (line) => ghost)
await_fr DRIVING

yap "threads:", RESULTS["threads"], "config at start:", RESULTS["config"]
grind line in RESULTS["conversation"] {
    yap line
}
yap "page views from four clients at once:", RESULTS["views"], "of 40"
yap "every thread reported back:", summary["per_thread"].how_thicc() == 4

// -- part three: what it left on disk ------------------------------------------------------

yap "-- data at rest, afterwards --"
yo after = load_config(default_config_path(HERE), custom_config_path(DATA))
yo admin1 = after["config"]["users"]["admin"]
yap "loaded first on the next start:", after["source"]
yap "password:", yapper.slice(admin1["password"], 0, 7), admin1["password"] == hash_password("correct horse battery")
yap "display name:", admin1["profile"]["display_name"], "->", unseal(admin1["profile"]["display_name"])
yap "email:", admin1["profile"]["email"]
yap "defaults:", admin1["defaults"]
yap "demo untouched:", after["config"]["users"]["demo"]["password"] == hash_password("funnylang")
yap "the committed default untouched:",
    load_config(default_config_path(HERE), "")["config"]["users"]["admin"]["password"] == hash_password("funnylang")

yo log = json.parse(filez.slurp(activity_path(DATA)))
yo counts = {}
yo sealed = fax
grind e in log {
    counts[e["action"]] = counts.get(e["action"], 0) + 1
    sealed = sealed && yapper.starts_with(e["ip"], "b64:") && yapper.starts_with(e["agent"], "b64:")
}
yap "activity.json:"
grind action in counts.keys().sort() {
    yap "  " + action + ":", counts[action]
}
yap "addresses and browsers sealed in every entry:", sealed

filez.obliterate(custom_config_path(DATA))
filez.obliterate(activity_path(DATA))
filez.obliterate(DATA)
