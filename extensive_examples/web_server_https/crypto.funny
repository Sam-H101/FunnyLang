// crypto.funny — SHA-256 and base64, in FunnyLang.
//
// Both are ordinary computation over bytes, which is why they live up here
// with everything else rather than in the C runtime (PLAN.md §2.1). TLS is
// the exception, and PLAN.md says why; a hash that runs once per login is not.
//
// A yapstring is a sequence of codepoints and both algorithms are defined over
// bytes, so text goes through utf8_bytes() first. That is what makes
// sha256_hex("é") agree with every other SHA-256 in the world.
//
// FunnyLang integers are arbitrary precision, so the 32-bit wrap-around that
// SHA-256 depends on is spelled out with `& MASK32` after every addition and
// every left shift. Nothing here ever gets near 2^63, so the VM stays on its
// small-integer fast path throughout.

gimme yapper

flex deadass HEX_DIGITS = "0123456789abcdef"
deadass MASK32 = 0xFFFFFFFF
deadass REPLACEMENT = "\u{FFFD}"

// -- bytes <-> text -------------------------------------------------------------

flex bet utf8_bytes(text) {
    yo out = []
    grind ch in text {
        yo cp = ch.code_at(0)
        sus (cp < 0x80) {
            out.yeet_in(cp)
        } kinda_sus (cp < 0x800) {
            out.yeet_in(0xC0 | (cp >> 6))
            out.yeet_in(0x80 | (cp & 0x3F))
        } kinda_sus (cp < 0x10000) {
            out.yeet_in(0xE0 | (cp >> 12))
            out.yeet_in(0x80 | ((cp >> 6) & 0x3F))
            out.yeet_in(0x80 | (cp & 0x3F))
        } nah {
            out.yeet_in(0xF0 | (cp >> 18))
            out.yeet_in(0x80 | ((cp >> 12) & 0x3F))
            out.yeet_in(0x80 | ((cp >> 6) & 0x3F))
            out.yeet_in(0x80 | (cp & 0x3F))
        }
    }
    bounce out
}

// The inverse. A malformed sequence becomes U+FFFD rather than an error: this
// decodes data that came off disk, and one bad byte should cost one character,
// not the whole value.
flex bet utf8_text(bytes) {
    yo out = []
    yo i = 0
    yo n = bytes.how_thicc()
    bruh (i < n) {
        yo b0 = bytes[i]
        yo need = -1
        yo cp = 0
        sus (b0 < 0x80) {
            need = 0
            cp = b0
        } kinda_sus ((b0 & 0xE0) == 0xC0) {
            need = 1
            cp = b0 & 0x1F
        } kinda_sus ((b0 & 0xF0) == 0xE0) {
            need = 2
            cp = b0 & 0x0F
        } kinda_sus ((b0 & 0xF8) == 0xF0) {
            need = 3
            cp = b0 & 0x07
        }
        yo ok = need >= 0 && i + need < n
        yo k = 1
        bruh (ok && k <= need) {
            yo b = bytes[i + k]
            sus ((b & 0xC0) == 0x80) {
                cp = (cp << 6) | (b & 0x3F)
            } nah {
                ok = cap
            }
            k += 1
        }
        sus (ok && (cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF))) {
            ok = cap
        }
        sus (ok) {
            out.yeet_in(yapper.chr_of(cp))
            i += need + 1
        } nah {
            out.yeet_in(REPLACEMENT)
            i += 1
        }
    }
    bounce out.join("")
}

flex bet hex_of_bytes(bytes) {
    yo out = []
    grind b in bytes {
        out.yeet_in(HEX_DIGITS[(b >> 4) & 0xF] + HEX_DIGITS[b & 0xF])
    }
    bounce out.join("")
}

// -- SHA-256 (FIPS 180-4) ---------------------------------------------------------

deadass K = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
]

deadass H_INIT = [
    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
]

bet rotr(x, n) {
    bounce ((x >> n) | (x << (32 - n))) & MASK32
}

// The 32-byte digest of a stash of byte values.
flex bet sha256_bytes(message) {
    yo bytes = message.clone()
    yo bit_len = message.how_thicc() * 8
    bytes.yeet_in(0x80)
    bruh (bytes.how_thicc() % 64 != 56) {
        bytes.yeet_in(0)
    }
    grind i from 7 to -1 step -1 {
        bytes.yeet_in((bit_len >> (i * 8)) & 0xFF)
    }

    yo h = H_INIT.clone()
    yo w = [0] * 64
    grind chunk from 0 to bytes.how_thicc() step 64 {
        grind t from 0 to 16 {
            yo j = chunk + t * 4
            w[t] = (bytes[j] << 24) | (bytes[j + 1] << 16) | (bytes[j + 2] << 8) | bytes[j + 3]
        }
        grind t from 16 to 64 {
            yo x = w[t - 15]
            yo y = w[t - 2]
            yo s0 = rotr(x, 7) ^ rotr(x, 18) ^ (x >> 3)
            yo s1 = rotr(y, 17) ^ rotr(y, 19) ^ (y >> 10)
            w[t] = (w[t - 16] + s0 + w[t - 7] + s1) & MASK32
        }

        yo a = h[0]
        yo b = h[1]
        yo c = h[2]
        yo d = h[3]
        yo e = h[4]
        yo f = h[5]
        yo g = h[6]
        yo hh = h[7]
        grind t from 0 to 64 {
            yo big_s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
            // (~e & g), spelled with an xor so nothing depends on how `~`
            // treats a number that is only meant to be 32 bits wide.
            yo choose = (e & f) ^ ((e ^ MASK32) & g)
            yo t1 = (hh + big_s1 + choose + K[t] + w[t]) & MASK32
            yo big_s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
            yo majority = (a & b) ^ (a & c) ^ (b & c)
            yo t2 = (big_s0 + majority) & MASK32
            hh = g
            g = f
            f = e
            e = (d + t1) & MASK32
            d = c
            c = b
            b = a
            a = (t1 + t2) & MASK32
        }
        h[0] = (h[0] + a) & MASK32
        h[1] = (h[1] + b) & MASK32
        h[2] = (h[2] + c) & MASK32
        h[3] = (h[3] + d) & MASK32
        h[4] = (h[4] + e) & MASK32
        h[5] = (h[5] + f) & MASK32
        h[6] = (h[6] + g) & MASK32
        h[7] = (h[7] + hh) & MASK32
    }

    yo digest = []
    grind word in h {
        digest.yeet_in((word >> 24) & 0xFF)
        digest.yeet_in((word >> 16) & 0xFF)
        digest.yeet_in((word >> 8) & 0xFF)
        digest.yeet_in(word & 0xFF)
    }
    bounce digest
}

// SHA-256 of text (as UTF-8), as 64 lowercase hex digits.
flex bet sha256_hex(text) {
    bounce hex_of_bytes(sha256_bytes(utf8_bytes(text)))
}

// -- base64 (RFC 4648: standard alphabet, padded) -----------------------------------

flex deadass B64_ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

yo B64_INDEX = {}
grind i from 0 to 64 {
    B64_INDEX[B64_ALPHABET[i]] = i
}

flex bet base64_encode_bytes(bytes) {
    yo out = []
    yo n = bytes.how_thicc()
    yo i = 0
    bruh (i + 2 < n) {
        yo triple = (bytes[i] << 16) | (bytes[i + 1] << 8) | bytes[i + 2]
        out.yeet_in(B64_ALPHABET[(triple >> 18) & 63] + B64_ALPHABET[(triple >> 12) & 63] +
                    B64_ALPHABET[(triple >> 6) & 63] + B64_ALPHABET[triple & 63])
        i += 3
    }
    yo left = n - i
    sus (left == 1) {
        yo triple = bytes[i] << 16
        out.yeet_in(B64_ALPHABET[(triple >> 18) & 63] + B64_ALPHABET[(triple >> 12) & 63] + "==")
    } kinda_sus (left == 2) {
        yo triple = (bytes[i] << 16) | (bytes[i + 1] << 8)
        out.yeet_in(B64_ALPHABET[(triple >> 18) & 63] + B64_ALPHABET[(triple >> 12) & 63] +
                    B64_ALPHABET[(triple >> 6) & 63] + "=")
    }
    bounce out.join("")
}

flex bet base64_encode(text) {
    bounce base64_encode_bytes(utf8_bytes(text))
}

// `ghost` for anything that is not well-formed padded base64, rather than a
// best-effort guess: a value that will not decode means the file was edited by
// hand or damaged, and the caller should hear about it.
flex bet base64_decode_bytes(encoded) {
    yo n = encoded.how_thicc()
    sus (n % 4 != 0) {
        bounce ghost
    }
    yo out = []
    grind i from 0 to n step 4 {
        yo quad = [0, 0, 0, 0]
        yo pad = 0
        grind k from 0 to 4 {
            yo ch = encoded[i + k]
            sus (ch == "=") {
                // Padding only in the last group, only in its last two places.
                sus (i + 4 != n || k < 2) {
                    bounce ghost
                }
                pad += 1
            } nah {
                sus (pad > 0 || !B64_INDEX.has(ch)) {
                    bounce ghost
                }
                quad[k] = B64_INDEX[ch]
            }
        }
        yo triple = (quad[0] << 18) | (quad[1] << 12) | (quad[2] << 6) | quad[3]
        out.yeet_in((triple >> 16) & 0xFF)
        sus (pad < 2) {
            out.yeet_in((triple >> 8) & 0xFF)
        }
        sus (pad < 1) {
            out.yeet_in(triple & 0xFF)
        }
    }
    bounce out
}

flex bet base64_decode(encoded) {
    yo bytes = base64_decode_bytes(encoded)
    sus (bytes == ghost) {
        bounce ghost
    }
    bounce utf8_text(bytes)
}
