// keeper_client.funny — a worker's side of the keeper, over DMs.
//
// This used to be a loopback socket: one JSON object per line, after a shared
// secret as the first line, with a small connection pool per worker. All of
// that existed to carry a value from one thread to another, which is now what
// `interns.dm` does -- no port, no secret, no encoder, no pool, and nothing
// that can be dialled by anything else on the machine.
//
// The one thing a connection gave for free was correlation: a reply came back
// on the connection that asked for it. A VM has exactly one inbox and a worker
// runs many tasks at once, so every request carries a number, and one task
// owns the inbox: the mailman takes each reply and leaves it under its number.
// The asking task waits by yielding until its own number turns up.
//
// `clock.chill(0)` is that yield: it settles on the next turn of this thread's
// event loop, so waiting costs a turn rather than a sleep, and every other
// task on this worker keeps running while one waits.

gimme interns
gimme clock

// How long a worker waits for the keeper before deciding it is gone. Generous:
// the keeper does PBKDF2 on a login, which is deliberately slow.
deadass ANSWER_SECONDS = 10.0

flex bet keeper_link() {
    yo link = {"next": 0, "replies": {}, "closed": cap, "mailman": ghost}
    link["mailman"] = collect_replies(link)
    bounce link
}

// The only task that reads this worker's inbox. Everything it finds is a
// reply to somebody, filed under the number that asked.
async_ngl bet collect_replies(link) {
    bruh (!link["closed"]) {
        yo m = await_fr interns.check_dms(250)
        sus (m != ghost) {
            yo body = m["msg"]
            sus (what_is_it(body) == "groupchat" && body.has("rid")) {
                link["replies"][to_yap(body["rid"])] = body["reply"]
            }
        }
    }
}

flex async_ngl bet ask_keeper(link, msg) {
    link["next"] += 1
    yo rid = link["next"]
    yo out = msg.clone()
    out["rid"] = rid
    interns.dm("boss", out)

    yo key = to_yap(rid)
    yo deadline = clock.now() + ANSWER_SECONDS
    bruh (!link["replies"].has(key)) {
        sus (clock.now() > deadline) {
            chuck oops("SkillIssue", "the keeper isn't answering")
        }
        await_fr clock.chill(0)
    }
    yo reply = link["replies"][key]
    link["replies"].remove(key)
    bounce reply
}

flex bet close_link(link) {
    link["closed"] = fax
}
