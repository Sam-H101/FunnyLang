// server.funny — starting everything, and stopping it again.
//
//   main thread   this file: opens the listeners, hires everybody, prints the
//                 log, waits
//   keeper        one intern: config, sessions, activity, rate limits, the
//                 stop flag (keeper.funny)
//   workers       N interns, default 24, all accepting from the one HTTPS
//                 listener (worker.funny)
//   redirect      one intern on the plain-http port, answering 301 to
//                 everything (redirect.funny)
//
// Listeners are opened *here*, before anybody is hired, and handed out as
// handles: a listener is a numba, so it crosses to a worker, and opening it
// first means a bad certificate or a busy port fails before there are two
// dozen threads to clean up.
//
// Stopping: anybody may tell the keeper "stop" -- serve.funny's --seconds,
// its --requests budget, a test. Workers ask the keeper twice a second and
// wind down when it says so; this thread waits for all of them, then tells
// the keeper to quit, which flushes the activity file.
//
// FAILING SAFELY. Every intern here runs until the keeper tells it to stop,
// and a VM that ends waits for every intern it hired. So an error that left
// this function early -- a worker that fell over, a hire that failed -- used
// to leave the keeper and the other workers running with nobody left to stop
// them, and the program hung in its own teardown. Now nothing leaves early:
// each intern's failure is collected rather than raised, the keeper is told to
// stop the moment anything fails, everything winds down as it would anyway,
// and only then is the first failure raised.

gimme internet
gimme interns
gimme clock
gimme filez
gimme yapper
gimme { load_config, unseal, setting, use_key, default_config_path, custom_config_path } from "store.funny"
gimme json
gimme vault
gimme { keeper_start, keeper_handle, keeper_tick, keeper_finish } from "keeper.funny"

flex deadass DEFAULTS = {
    "port": 8443,
    "host": "127.0.0.1",
    "http_port": 8080,
    "threads": 24,
    "data_dir": ghost,
    "seconds": ghost,
    "requests": ghost,
    "pfx": ghost,
    "password": ghost,
    "public_host": ghost,
}

// Tells the keeper to stop. It is a function call now, not a socket: the
// keeper lives on this thread. Workers notice within half a second, on their
// next ping.
flex bet stop_server(info) {
    keeper_handle({"op": "stop"})
}

// The keeper's own turn: answer whatever the workers have asked, then do the
// periodic work its flusher task used to do. Called from the main loop, which
// is the only place any of this runs -- so none of the keeper's state needs a
// lock, for the same reason it never did.
async_ngl bet keeper_pump(state) {
    bruh (!state["done"]) {
        yo m = await_fr interns.check_dms(50)
        sus (m != ghost) {
            yo msg = m["msg"]
            yo rid = what_is_it(msg) == "groupchat" ? msg.get("rid", ghost) : ghost
            yo reply = keeper_handle(msg)
            sus (rid != ghost) {
                sketchy {
                    interns.dm(m["from"], {"rid": rid, "reply": reply})
                } my_bad (e) {
                    // That worker finished between asking and being
                    // answered -- it was told to stop. Nobody is waiting
                    // for this reply, and LeftOnRead is the runtime saying
                    // exactly that.
                    vibe
                }
            }
        }
        keeper_tick()
    }
}

// Ends the server when `stop_when` settles. It is awaited in its own task so
// that waiting for Ctrl-C does not stop this thread from being the keeper.
async_ngl bet stop_watch(info, stop_when, state) {
    sketchy {
        await_fr stop_when
    } my_bad (e) {
        vibe
    }
    sus (!state["done"]) {
        stop_server(info)
    }
}

async_ngl bet deadline_watch(info, seconds, state) {
    yo stop_at = clock.now() + seconds
    bruh (!state["done"] && clock.now() < stop_at) {
        await_fr clock.chill(200)
    }
    sus (!state["done"]) {
        await_fr stop_server(info)
    }
}

// Waits for an intern without letting its failure cut the waiting short: the
// error goes into `failures`, to be raised once everything has wound down,
// and the answer is `ghost`.
async_ngl bet collect(otw, failures) {
    sketchy {
        bounce await_fr otw
    } my_bad (e) {
        failures.yeet_in(e)
        bounce ghost
    }
}


// The key everything at rest is sealed with. Outside data/ by default and
// never inside it: a key kept next to the data it seals is not encryption,
// it is a rearrangement. Made on first run, owner-only where the OS has a
// mode bit for that.
bet load_or_make_key(path) {
    sus (filez.exists(path)) {
        yo key = vault.base64_decode(yapper.trim(filez.slurp(path)))
        sus (key == ghost || how_thicc(key) != 32) {
            chuck oops("SkillIssue", path + " isn't a vault key: it should be 32 bytes, base64, on one line.")
        }
        bounce key
    }
    yo fresh = vault.new_key()
    filez.yeet_out_atomic(path, vault.base64_encode(fresh) + "\n")
    filez.private(path)
    bounce fresh
}

// Runs the whole server until something stops it. `on_ready(info)` is called
// once everything is listening -- info has the ports, the thread count and
// which config was loaded -- and `on_log(line)` once per request.
// `stop_when` is an `otw` that ends the server when it settles -- the CLI
// passes computer.until_ctrl_c(), a test passes ghost and calls stop_server
// itself. The log is no longer a parameter: workers are live and print
// their own lines as they serve.
flex async_ngl bet run_server(example_dir, options, on_ready, stop_when) {
    yo opts = DEFAULTS.clone()
    opts.merge(options)
    yo threads = to_int(opts["threads"])
    sus (threads < 1) {
        threads = 1
    }
    sus (threads > 64) {
        threads = 64
    }
    yo data_dir = opts["data_dir"] ?? filez.join_path(example_dir, "data")
    sus (!filez.is_dir(data_dir)) {
        filez.mkdir(data_dir)
    }

    yo key_path = opts["key_file"] ?? filez.join_path(filez.dir_of(data_dir), "vault.key")
    yo key = load_or_make_key(key_path)
    use_key(key)

    // Loaded here as well as in the keeper, so a damaged customization file
    // stops the server with a clear message before any thread starts.
    yo loaded = load_config(default_config_path(example_dir), custom_config_path(data_dir))
    yo cfg = loaded["config"]
    yo pfx = opts["pfx"] ?? filez.join_path(example_dir, setting(cfg, "tls", "pfx", "certs/site.p12"))
    yo password = opts["password"] ?? unseal(setting(cfg, "tls", "password", ""))

    yo https = internet.open_secure_shop(opts["port"], opts["host"], {"pfx": pfx, "password": password})
    yo https_port = internet.shop_port(https)
    yo http = ghost
    yo http_port = ghost
    sus (opts["http_port"] != ghost) {
        sketchy {
            http = internet.open_shop(opts["http_port"], opts["host"])
        } my_bad (e) {
            internet.close_shop(https)
            chuck e
        }
        http_port = internet.shop_port(http)
    }
    yo host = opts["host"]
    yo public_host = opts["public_host"] ??
                     ((host == "127.0.0.1" || host == "" || host == ghost || host == "0.0.0.0") ? "localhost" : host)

    yo info = {
        "https_port": https_port,
        "http_port": http_port,
        "public_host": public_host,
        "threads": threads,
        "config": loaded["source"],
        "config_path": loaded["path"],
        "data_dir": data_dir,
    }

    // From the first hire on, nothing may leave this function early: see
    // "failing safely" at the top.
    yo failures = []
    yo workers = []
    yo redirect = ghost
    sketchy {
        // The keeper is a module on this thread now, not an intern: there is
        // no listener to open, no secret to share and no protocol to speak.
        keeper_start({
            "example_dir": example_dir,
            "data_dir": data_dir,
            "key": vault.base64_encode(key),
            "budget": opts["requests"],
        })
        yo started_at = clock.now()
        yo worker_src = filez.join_path(example_dir, "worker.funny")
        yo web_dir = filez.join_path(example_dir, "web")
        grind k from 1 to threads + 1 {
            // {"live": fax}: a worker's log goes straight to this process's
            // stderr as it happens, instead of being held and replayed when
            // the worker is joined -- which for a server that runs for hours
            // would mean seeing the log at the end.
            workers.yeet_in(interns.hire(worker_src, {
                "listener": https,
                "thread": k,
                "threads": threads,
                "web_dir": web_dir,
                "started_at": started_at,
            }, {"live": fax}))
        }
        sus (http != ghost) {
            redirect = interns.hire(filez.join_path(example_dir, "redirect.funny"), {
                "listener": http,
                "https_port": https_port,
                "public_host": public_host,
            }, {"live": fax})
        }
    } my_bad (e) {
        failures.yeet_in(e)
    }

    yo state = {"done": cap}
    yo pump = ghost
    yo watch = ghost
    yo stopper = ghost
    sus (failures.how_thicc() == 0) {
        pump = keeper_pump(state)
        watch = opts["seconds"] == ghost ? ghost : deadline_watch(info, opts["seconds"], state)
        stopper = stop_when == ghost ? ghost : stop_watch(info, stop_when, state)
        sketchy {
            on_ready(info)
        } my_bad (e) {
            failures.yeet_in(e)
        }
    }
    sus (failures.how_thicc() > 0) {
        await_fr stop_server(info)
    }

    // Wind down. Each worker stops when the keeper says so; if one falls
    // over instead, the rest are told to stop straight away rather than
    // serving on while this waits for the one that is not coming back.
    yo per_thread = []
    grind w in workers {
        yo result = await_fr collect(w, failures)
        sus (result == ghost) {
            await_fr stop_server(info)
            per_thread.yeet_in(0)
        } nah {
            per_thread.yeet_in(result["served"])
        }
    }
    sus (redirect != ghost) {
        await_fr collect(redirect, failures)
    }
    // The keeper is on this thread, so its last write is a call rather than
    // a message and a join.
    yo kept = keeper_finish()
    state["done"] = fax
    sus (pump != ghost) {
        await_fr pump
    }
    // The stop watcher is deliberately not awaited. It is parked on an otw
    // that only a Ctrl-C settles, and the program is finishing; the loop
    // strands that wait at teardown and the watcher's own sketchy swallows
    // it. Awaiting it here is what made `--seconds` never return.
    sus (watch != ghost) {
        await_fr watch
    }
    internet.close_shop(https)
    sus (http != ghost) {
        internet.close_shop(http)
    }
    sus (failures.how_thicc() > 0) {
        chuck failures[0]
    }
    bounce {"served": kept["served"], "per_thread": per_thread, "activity": kept["activity"], "config": kept["config"]}
}
