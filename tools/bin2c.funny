// tools/bin2c.funny — NATIVE_PLAN.md N10 task 1's generator: turns a binary
// file into a C source file holding it as a byte array.
//
//     funny tools/bin2c.funny -- <input> <output.c> <symbol>
//
// Used to embed the linked toolchain bundle into the binary, so the shipped
// artifact is one file with no sidecar. The generated file is checked in,
// following the same pattern as `unicode_tbl.c`: a fresh clone builds with a
// C compiler alone, and regenerating is a dev-time step.
//
// Written in FunnyLang, not Python, on purpose — N11 removes every `.py`
// from the repository including dev tooling, so a generator written in
// Python today is one that has to be rewritten then. It also means the
// toolchain generates the artifact that *is* the toolchain, which is either
// elegant or alarming depending on the hour.
//
// Restricted to the self-hosting subset (PLAN.md §8).

gimme filez
gimme yapper

// 24 to a line keeps the generated file's width reasonable while still
// being about a fifth as many lines as one-per-line would be. Plain decimal
// rather than 0x-hex: shorter, and nothing reads this by eye anyway.
flex deadass PER_LINE = 24

flex bet generate(bytes, symbol, source_name) {
    yo out = []
    out.yeet_in("/* GENERATED by tools/bin2c.funny -- do not hand-edit.")
    out.yeet_in(" *")
    out.yeet_in(" * Source: " + source_name)
    out.yeet_in(" * Bytes:  " + to_yap(bytes.how_thicc()))
    out.yeet_in(" *")
    out.yeet_in(" * Regenerate with:")
    out.yeet_in(" *     funny tools/bin2c.funny -- " + source_name + " native/" + symbol + ".c " + symbol)
    out.yeet_in(" *")
    out.yeet_in(" * A staleness test relinks the source and compares, so this cannot")
    out.yeet_in(" * drift from what it was generated from without something noticing.")
    out.yeet_in(" */")
    out.yeet_in("#include \"" + symbol + ".h\"")
    out.yeet_in("")
    out.yeet_in("const unsigned int " + symbol + "_len = " + to_yap(bytes.how_thicc()) + "u;")
    out.yeet_in("")
    out.yeet_in("const unsigned char " + symbol + "[] = {")

    yo n = bytes.how_thicc()
    yo line = []
    grind i from 0 to n {
        line.yeet_in(to_yap(bytes[i]) + ",")
        sus (line.how_thicc() == PER_LINE) {
            out.yeet_in("    " + line.join(""))
            line = []
        }
    }
    sus (line.how_thicc() > 0) {
        out.yeet_in("    " + line.join(""))
    }
    out.yeet_in("};")
    out.yeet_in("")
    bounce out.join("\n")
}

flex bet generate_header(symbol, source_name) {
    yo guard = "FUNNY_" + yapper.SCREAM(symbol) + "_H"
    yo out = []
    out.yeet_in("/* GENERATED by tools/bin2c.funny -- do not hand-edit.")
    out.yeet_in(" * The declaration for " + symbol + ".c, whose bytes are " + source_name + ". */")
    out.yeet_in("#ifndef " + guard)
    out.yeet_in("#define " + guard)
    out.yeet_in("")
    out.yeet_in("extern const unsigned char " + symbol + "[];")
    out.yeet_in("extern const unsigned int " + symbol + "_len;")
    out.yeet_in("")
    out.yeet_in("#endif /* " + guard + " */")
    out.yeet_in("")
    bounce out.join("\n")
}

yo args = the_args()
sus (args.how_thicc() < 3) {
    yell("usage: bin2c <input> <output.c> <symbol>")
    dip(1)
}
yo input_path = args[0]
yo output_path = args[1]
yo symbol = args[2]

sus (!filez.exists(input_path)) {
    yell("bin2c: can't read '" + input_path + "'.")
    dip(1)
}

yo bytes = filez.read_bytes(input_path)
filez.yeet_out(output_path, generate(bytes, symbol, input_path))

// The header goes next to the source, named after the symbol -- so one
// invocation produces a complete, compilable pair.
yo header_path = yapper.slice(output_path, 0, output_path.how_thicc() - 2) + ".h"
filez.yeet_out(header_path, generate_header(symbol, input_path))

yap "embedded " + to_yap(bytes.how_thicc()) + " bytes of " + input_path + " into " + output_path + " (+ " + header_path + ")."
