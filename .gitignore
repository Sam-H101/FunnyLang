.claude/
__pycache__/
*.pyc
build/
dist/
*.egg-info/
.pytest_cache/
*.funnyc
*.funnypak
# ...except the bootstrap compiler (NATIVE_PLAN.md §4 lists it as checked
# in). It is what lets a machine with only a C compiler build `funny` and
# then compile FunnyLang, with no Python anywhere; see bootstrap/STAGE0.md
# for its provenance and the staleness check that keeps it honest.
!bootstrap/funnyc.funnypak
!bootstrap/cli.funnypak
*.exe
.coverage
htmlcov/

# native/ build output (build.sh / build.bat -- NATIVE_PLAN.md N0/N7):
# the CLI, and the runtime stub `funny yeet` appends programs to.
/funny
/funnyrt
*.obj
*.pdb
*.ilk
*.o
