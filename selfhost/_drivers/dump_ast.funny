// Test driver (not part of the toolchain): prints the s-expression dump of
// the file named by the first CLI arg, to cross-check selfhost/parser.funny's
// AST against funnylang's own parser -- byte-exactness discipline (PLAN.md
// §M12 task 3) for the parser stage.
//
// The dump itself used to live here; it moved to selfhost/astdump.funny when
// `funny xray --ast` (NATIVE_PLAN.md N8 task 2) needed the same rendering,
// so this file is now just the argv handling around it.
gimme filez
gimme { tokenize } from "../lexer.funny"
gimme { parse_program } from "../parser.funny"
gimme { dump } from "../astdump.funny"

yo path = the_args()[0]
yo src = filez.slurp(path)
yo prog = parse_program(tokenize(src))
yap dump(prog)
