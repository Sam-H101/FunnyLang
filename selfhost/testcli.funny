// selfhost/testcli.funny — NATIVE_PLAN.md N10 task 1: the standalone CLI over
// test.funny, so the tool stays runnable on its own
// (`funny selfhost/testcli.funny -- ...`) while `cli.funny` imports the
// library directly rather than compiling this file at run time.
//
// Restricted to the self-hosting subset (PLAN.md §8).

gimme { run_tests } from "test.funny"

yo args = the_args()
sus (args.how_thicc() < 1) {
    yap "usage: test <dir>"
    dip(1)
}
dip(run_tests(args[0]))
