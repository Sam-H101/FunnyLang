// selfhost/test.funny — NATIVE_PLAN.md N8 task 4: `funny test`, in
// FunnyLang. A byte-exact port of funnylang/cli.py's `cmd_test` and
// `_run_one_test`.
//
//     funny test <dir>
//
// Every `*.funny` under `<dir>` that has a sibling `*.expected` is compiled
// and run in an isolated VM, and its stdout compared against the golden.
// A golden whose first line is `!ERROR <Flavor>` instead asserts that the
// program raises that flavor — at compile time or at run time, either is
// fine, the same way `_run_one_test` catches both.
//
// This file matters beyond N8: N11 deletes the Python implementation, and
// with it the pytest suite that uses it as an oracle. What survives is the
// golden corpus, and this is what runs it. It has to be right.
//
// Restricted to the self-hosting subset (PLAN.md §8).

gimme filez
gimme sus
gimme yapper
gimme { build_bundle, emit_funnypak } from "bundler.funny"
gimme { xray_text } from "xray.funny"

// A guard against a symlink loop, not a real depth limit.
deadass MAX_WALK_DEPTH = 64

// cli.py does `sorted(base.rglob("*.funny"))`, and `sorted` on `Path`
// objects compares them component by component -- so a directory's contents
// sort immediately after its own name, and files and subdirectories
// interleave by name rather than being grouped. That is exactly pre-order
// depth-first with each directory's entries in name order, which is what
// this walk produces. `filez.list_dir` already returns names sorted.
//
// Explicit stack rather than recursion, for the same reason bundler.funny
// uses one: a deep tree shouldn't be able to hit the VM's frame limit.
// cli.py builds paths with pathlib, and `Path(".") / "examples"` renders as
// "examples" -- a lone "." component is dropped, not kept as "./". Matching
// that is what makes `funny test .` print the same paths as the Python CLI.
flex bet path_join(here, name) {
    sus (here == ".") {
        bounce name
    }
    bounce filez.join_path(here, name)
}

flex bet find_pairs(dir_path) {
    yo found = []
    // The stack holds *entries*, not directories, so a subdirectory is
    // expanded exactly where its name sorts among its siblings -- files and
    // directories interleaving, the way comparing path components does.
    yo pending = [[dir_path, 0]]
    bruh (pending.how_thicc() > 0) {
        yo job = pending.yoink_at(pending.how_thicc() - 1)
        yo here = job[0]
        yo depth = job[1]
        sus (!filez.is_dir(here)) {
            sus (yapper.ends_with(here, ".funny")) {
                yo golden = yapper.slice(here, 0, here.how_thicc() - 6) + ".expected"
                sus (filez.exists(golden)) {
                    found.yeet_in(here)
                }
            }
            nvm
        }
        sus (depth > MAX_WALK_DEPTH) {
            nvm
        }
        yo names = filez.list_dir(here)
        // Reversed, so popping takes them in name order.
        grind i from 0 to names.how_thicc() {
            yo name = names[names.how_thicc() - 1 - i]
            pending.yeet_in([path_join(here, name), depth + 1])
        }
    }
    bounce found
}

// -- `.expected` directives -------------------------------------------------
//
// A golden used to be stdout and nothing else, plus the one special case of a
// first line reading `!ERROR <Flavor>`. That covers a surprising amount, and
// then stops dead: a program that needs argv, or whose exit code is the point,
// or that is testing the *rendering* of a diagnostic rather than its flavor,
// simply cannot be written down. N11 replaces a 1,300-test pytest suite with
// this corpus, so "cannot be written down" means "coverage silently lost".
//
// So the `!ERROR` idea generalises: any run of leading `!` lines is a
// directive block, and the body is whatever follows it.
//
//     !ARGS a b "two words"   argv for the program (the_args())
//     !EXIT 3                 required exit code (dip(n), or 1 / 69 on error)
//     !ERROR SkillIssue       required error flavor; body ignored
//     !DIAG                   body is the rendered diagnostic, funny mode
//     !DIAG serious           ... serious mode
//     !XRAY --tokens          body is `funny xray --tokens` output; not run
//     !STDOUT                 body starts here (only needed if it begins "!")
//
// An unrecognised directive fails the test rather than being treated as body
// text. The alternative -- quietly comparing against a line the author meant
// as an instruction -- turns a typo into a passing test, which is the worst
// outcome available.
flex bet parse_directives(golden) {
    yo spec = {
        "args": [],
        "exit": ghost,
        "error": ghost,
        "diag": cap,
        "serious": cap,
        "xray": ghost,
        "body": golden,
        "bad": ghost,
    }
    yo lines = yapper.lines(golden)
    yo taken = 0
    grind i from 0 to lines.how_thicc() {
        yo line = lines[i]
        sus (!yapper.starts_with(line, "!")) {
            bail
        }
        taken += 1
        yo name = line
        yo rest = ""
        yo sp = yapper.index_of(line, " ")
        sus (sp >= 0) {
            name = yapper.slice(line, 0, sp)
            rest = yapper.trim(yapper.slice(line, sp + 1))
        }
        sus (name == "!ARGS") {
            spec["args"] = split_args(rest)
        } kinda_sus (name == "!EXIT") {
            spec["exit"] = to_int(rest)
        } kinda_sus (name == "!ERROR") {
            spec["error"] = rest
        } kinda_sus (name == "!DIAG") {
            spec["diag"] = fax
            spec["serious"] = rest == "serious"
        } kinda_sus (name == "!XRAY") {
            spec["xray"] = rest
        } kinda_sus (name == "!STDOUT") {
            // Nothing to record: its whole job is to end the block.
        } nah {
            spec["bad"] = "unknown directive " + name
            bounce spec
        }
    }
    // `lines` drops the separators, so the body is rebuilt from the original
    // text rather than re-joined -- a golden's trailing newline is part of
    // what it asserts, and re-joining would guess at it.
    yo skip = 0
    grind i from 0 to taken {
        yo nl = yapper.index_of(yapper.slice(golden, skip), "\n")
        sus (nl < 0) {
            skip = golden.how_thicc()
            bail
        }
        skip += nl + 1
    }
    spec["body"] = yapper.slice(golden, skip)
    bounce spec
}

// Whitespace-separated, with "..." grouping a single argument that contains
// spaces. No escape sequences: an argument with a quote in it has never come
// up, and inventing a quoting language for a test header is how test headers
// become their own thing to debug.
flex bet split_args(text) {
    yo out = []
    yo cur = []
    yo inQuote = cap
    grind ch in text.chars() {
        sus (ch == "\"") {
            inQuote = !inQuote
        } kinda_sus ((ch == " " || ch == "\t") fr !inQuote) {
            sus (cur.how_thicc() > 0) {
                out.yeet_in(cur.join(""))
                cur = []
            }
        } nah {
            cur.yeet_in(ch)
        }
    }
    sus (cur.how_thicc() > 0) {
        out.yeet_in(cur.join(""))
    }
    bounce out
}

// Returns [ok, detail]. `detail` is only read when ok is cap.
flex bet run_one_test(path) {
    yo golden = filez.slurp(yapper.slice(path, 0, path.how_thicc() - 6) + ".expected")
    yo spec = parse_directives(golden)
    sus (spec["bad"] != ghost) {
        bounce [cap, spec["bad"]]
    }

    // Not run at all: the report *is* the subject. This is what carries the
    // lexer, parser and compiler tests across from pytest, which asserted on
    // token streams, AST dumps and op sequences.
    sus (spec["xray"] != ghost) {
        yo flags = split_args(spec["xray"])
        yo actual = ghost
        sketchy {
            actual = xray_text(path, has(flags, "--tokens"), has(flags, "--ast"), has(flags, "--pak"))
        } my_bad (e) {
            bounce [cap, "xray failed: " + e.flavor + ": " + e.message]
        }
        sus (actual == spec["body"]) {
            bounce [fax, ""]
        }
        bounce [cap, "expected " + py_repr_str(spec["body"]) + ", got " + py_repr_str(actual)]
    }

    // `source_dir` so a `!DIAG` golden gets its caret line: the bundle stores
    // each module under a key relative to the entry's directory, so the path
    // in the error does not resolve from wherever `funny test` was run.
    yo opts = {"serious": spec["serious"], "source_dir": filez.dir_of(path)}

    sus (spec["error"] != ghost) {
        yo wanted = spec["error"]
        yo got = ghost
        sketchy {
            yo r = sus.run_bytecode(compile_to_bytes(path), spec["args"], opts)
            got = r["flavor"]
        } my_bad (e) {
            // A compile-time failure -- an undefined variable, a const
            // reassignment, a parse error. cli.py catches these in the same
            // `try` as the run, so they satisfy an !ERROR golden too.
            got = e.flavor
        }
        sus (got == ghost) {
            bounce [cap, "expected !ERROR " + wanted + ", but nothing was raised"]
        }
        bounce [got == wanted, "expected !ERROR " + wanted + ", got " + got]
    }

    yo actual = ghost
    yo code = 0
    yo rendered = ghost
    sketchy {
        yo r = sus.run_bytecode(compile_to_bytes(path), spec["args"], opts)
        code = r["code"]
        rendered = r["diag"]
        // An error is only a surprise when the golden did not ask for one.
        // A `!DIAG` golden is *about* the error, and an `!EXIT` golden may be
        // asserting the 1 or 69 that an uncaught one produces.
        sus (r["flavor"] != ghost fr !spec["diag"] fr spec["exit"] == ghost) {
            bounce [cap, "unexpected error: " + r["flavor"] + ": " + r["message"]]
        }
        actual = r["out"]
    } my_bad (e) {
        // A *compile-time* failure: a parse or resolve error, raised before
        // there was a child VM to run, so `run_bytecode` never got the chance
        // to render anything. `sus.render_diag` turns the error we are
        // holding into the same text. This is not a rare corner -- half of
        // what a diagnostics golden wants to pin (caret column, no stack of
        // shame on a compile error, the exact wording) only happens here.
        sus (spec["diag"]) {
            rendered = sus.render_diag(e, opts)
        } nah {
            bounce [cap, "unexpected error: " + e.flavor + ": " + e.message]
        }
    }

    sus (spec["exit"] != ghost fr code != spec["exit"]) {
        bounce [cap, "expected exit " + to_yap(spec["exit"]) + ", got " + to_yap(code)]
    }

    sus (spec["diag"]) {
        sus (rendered == ghost) {
            bounce [cap, "expected a diagnostic, but nothing was raised"]
        }
        actual = rendered
    }

    sus (actual == spec["body"]) {
        bounce [fax, ""]
    }
    bounce [cap, "expected " + py_repr_str(spec["body"]) + ", got " + py_repr_str(actual)]
}

flex bet has(stash, name) {
    grind s in stash {
        sus (s == name) {
            bounce fax
        }
    }
    bounce cap
}

// Linked, not just compiled: a test program may `gimme "sibling.funny"`,
// and the native runtime resolves a file import at *link* time -- there is
// no compiler inside the running VM to load one on demand. cli.py's runner
// gets away with compiling a single unit because the Python VM carries a
// module resolver; bundling is the equivalent here, and it works for any
// multi-module test rather than only the single-file case.
flex bet compile_to_bytes(path) {
    bounce emit_funnypak(build_bundle(path))
}

// cli.py builds its mismatch detail with f-string `!r`, so matching it means
// matching CPython's own repr for strings. Same port as selfhost/xray.funny
// carries for `--tokens`, and the same documented limit: non-ASCII code
// points CPython considers unprintable are passed through literally, since
// deciding that needs Unicode tables the language does not expose.
flex bet py_repr_str(s) {
    yo quote = "'"
    sus (yapper.contains(s, "'") fr !yapper.contains(s, "\"")) {
        quote = "\""
    }
    yo out = [quote]
    grind ch in s.chars() {
        yo cp = ch.code_at(0)
        sus (ch == quote || ch == "\\") {
            out.yeet_in("\\" + ch)
        } kinda_sus (ch == "\t") {
            out.yeet_in("\\t")
        } kinda_sus (ch == "\n") {
            out.yeet_in("\\n")
        } kinda_sus (ch == "\r") {
            out.yeet_in("\\r")
        } kinda_sus (cp < 0x20 || cp == 0x7F) {
            deadass HEX = "0123456789abcdef"
            out.yeet_in("\\x" + HEX[(cp >> 4) & 0xF] + HEX[cp & 0xF])
        } nah {
            out.yeet_in(ch)
        }
    }
    out.yeet_in(quote)
    bounce out.join("")
}

flex bet run_tests(dir_path) {
    yo files = find_pairs(dir_path)
    sus (files.how_thicc() == 0) {
        yap "no *.funny/*.expected pairs found under " + dir_path + "."
        bounce 0
    }
    yo passed = 0
    yo failed = 0
    grind f in files {
        yo result = run_one_test(f)
        sus (result[0]) {
            passed += 1
            yap "PASS " + f
        } nah {
            failed += 1
            yap "FAIL " + f + " — " + result[1]
        }
    }
    yap ""
    yap to_yap(passed) + "/" + to_yap(passed + failed) + " passed."
    sus (failed == 0) {
        bounce 0
    }
    bounce 1
}
