sketchy {
    yap "before"
    chuck "custom error"
    yap "unreachable"
} my_bad (e) {
    yap "caught:", e.message
    yap "flavor:", e.flavor
}
yap "after"

sketchy {
    yo x = 1 / 0
} my_bad (e) {
    yap "div error flavor:", e.flavor
}

yo log = ""
bet risky(n) {
    sketchy {
        sus (n == 0) {
            chuck "zero!"
        }
        bounce 100 / n
    } my_bad (e) {
        log = log + "[caught " + e.message + "]"
        bounce -1
    } regardless {
        log = log + "[finally]"
    }
}
yap risky(5)
yap risky(0)
yap log

sketchy {
    yap "try body"
} regardless {
    yap "finally runs even without an error"
}

bet returns_from_try() {
    sketchy {
        bounce "from try"
    } regardless {
        yap "finally still runs on early return"
    }
}
yap returns_from_try()

sketchy {
    sketchy {
        chuck "inner"
    } regardless {
        yap "inner finally"
        chuck "from finally"
    }
} my_bad (e) {
    yap "outer caught:", e.message
}

yo depth = 0
bet recurse_with_try(n) {
    sketchy {
        sus (n <= 0) {
            chuck "hit bottom"
        }
        bounce recurse_with_try(n - 1)
    } my_bad (e) {
        depth = depth + 1
        bounce depth
    }
}
yap recurse_with_try(3)
