// Variadic binding has to happen identically on every path that pushes a
// frame, not just the plain `f(...)` one -- a bare call, a bound-method
// value, an INVOKE on an instance, a callback re-entering from native code,
// and a constructor. Each of those is a separate site in the C VM.

bet sum_all(...rest) {
    yo total = 0
    grind n in rest { total += n }
    bounce total
}
yap sum_all()
yap sum_all(1, 2, 3, 4)

bet tag(label, ...rest) {
    bounce label + ":" + to_yap(rest.how_thicc())
}
yap tag("none")
yap tag("three", 1, 2, 3)

bet with_default(a, b = 10, ...rest) {
    bounce a + b + rest.how_thicc()
}
yap with_default(1)
yap with_default(1, 2)
yap with_default(1, 2, 3, 4)

squad Collector {
    spawn(...rest) { me.seen = rest.how_thicc() }
    bet take(...rest) {
        me.seen += rest.how_thicc()
        bounce me.seen
    }
}

// spawn is variadic too: the constructor path
yo c = Collector(1, 2)
yap c.seen

// INVOKE on an instance
yap c.take()
yap c.take(1, 2)

// a bound method held as a value, then called
yo m = c.take
yap m(1, 2, 3)

// a callback re-entered from native code (stash.glow_up)
yo doubled = [1, 2, 3].glow_up(lowkey (n) => { bounce sum_all(n, n) })
yap doubled

// too few arguments is still an error, and says "at least"
sketchy {
    tag()
} my_bad (e) {
    yap "caught:", e.flavor
    yap e.message
}
