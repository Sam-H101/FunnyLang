// sus.new_session / run_in / close_session: a child VM kept alive between
// calls, which is what a REPL is. `sus.run_bytecode`'s fresh-VM-every-time
// is exactly wrong for one: `yo x = 1` on one line has to still be there on
// the next.
//
// Bytecode is assembled by hand, for the same reason sus_run_bytecode.funny
// does it: a program under tests/native/programs/ is compiled as a single
// unit and cannot import selfhost/compiler.funny.

gimme sus

bet w8(buf, v) {
    buf.yeet_in(v & 0xFF)
}

bet w16(buf, v) {
    w8(buf, v >> 8)
    w8(buf, v)
}

bet w32(buf, v) {
    w16(buf, v >> 16)
    w16(buf, v)
}

bet wstr(buf, s) {
    w32(buf, s.how_thicc())
    grind ch in s.chars() {
        w8(buf, ch.code_at(0))
    }
}

// consts: ["str", value] or ["int", value]. `capture` mirrors the compiler's
// repl_capture_last: leave the last expression on the stack for RETURN
// instead of pushing ghost.
bet assemble(consts, code) {
    yo buf = []
    grind b in [0x46, 0x55, 0x4E, 0x4E, 0x59, 0x00] {
        buf.yeet_in(b)
    }
    w16(buf, 2)
    w16(buf, 1)
    wstr(buf, "<vibe>")
    w32(buf, consts.how_thicc())
    grind c in consts {
        sus (c[0] == "str") {
            w8(buf, 4)
            wstr(buf, c[1])
        } nah {
            w8(buf, 2)
            w8(buf, c[1] < 0 ? 1 : 0)
            yo mag = c[1] < 0 ? -c[1] : c[1]
            sus (mag == 0) {
                w32(buf, 0)
            } nah {
                w32(buf, 1)
                w8(buf, mag)
            }
        }
    }
    w32(buf, 1)
    wstr(buf, "<script>")
    w8(buf, 0)
    w8(buf, 0)
    w8(buf, 0)
    w8(buf, 0)
    w16(buf, 16)
    w8(buf, 0)
    w32(buf, code.how_thicc())
    buf.extend(code)
    w32(buf, 0)
    w32(buf, 0)
    bounce buf
}

deadass CONST = 1
deadass GHOST_OP = 2
deadass GET_GLOBAL = 10
deadass DEF_GLOBAL = 12
deadass ADD = 22
deadass CALL = 51
deadass RETURN = 55
deadass YAP_OP = 59
deadass CHUCK_OP = 60

yo s = sus.new_session()
yap what_is_it(s)

// yo counter = 1   (no trailing expression: repr is "ghost")
yo r1 = sus.run_in(s, assemble([["str", "counter"], ["int", 1]],
                               [CONST, 0, 1, DEF_GLOBAL, 0, 0, GHOST_OP, RETURN]))
yap r1["repr"], r1["flavor"], r1["code"]

// counter + 41  -- a "REPL expression": the value is left for RETURN, so it
// comes back as `repr`, and `counter` is still defined from the line before.
yo r2 = sus.run_in(s, assemble([["str", "counter"], ["int", 41]],
                               [GET_GLOBAL, 0, 0, CONST, 0, 1, ADD, RETURN]))
yap r2["repr"], r2["flavor"], r2["code"]

// Output is not captured: this really does print into our own stdout.
yo r3 = sus.run_in(s, assemble([["str", "counter"]],
                               [GET_GLOBAL, 0, 0, YAP_OP, 1, 1, GHOST_OP, RETURN]))
yap r3["repr"]

// repr, not display: a string comes back quoted.
yo r4 = sus.run_in(s, assemble([["str", "hi there"]], [CONST, 0, 0, RETURN]))
yap r4["repr"]

// An error in one input does not end the session.
yo r5 = sus.run_in(s, assemble([["str", "nope"]], [CONST, 0, 0, CHUCK_OP]))
yap r5["repr"], r5["flavor"], r5["message"], r5["code"]

yo r6 = sus.run_in(s, assemble([["str", "counter"]], [GET_GLOBAL, 0, 0, RETURN]))
yap r6["repr"], r6["flavor"]

// dip(n) inside a session is that session exiting, not the host.
yo r7 = sus.run_in(s, assemble([["str", "dip"], ["int", 4]],
                               [GET_GLOBAL, 0, 0, CONST, 0, 1, CALL, 1, RETURN]))
yap r7["code"], r7["flavor"]
yap "host still running"

// A second session has its own globals.
yo s2 = sus.new_session()
yo r8 = sus.run_in(s2, assemble([["str", "counter"]], [GET_GLOBAL, 0, 0, RETURN]))
yap r8["flavor"]

// ...and the first is unaffected.
yo r9 = sus.run_in(s, assemble([["str", "counter"]], [GET_GLOBAL, 0, 0, RETURN]))
yap r9["repr"]

// Closing one leaves the other alone. (`yo _ = ...` rather than a bare
// call: `sus` opens an if-statement, so a statement starting with `sus.` is
// a parse error in both implementations -- a pre-existing collision between
// the keyword and the module name.)
yo closed2 = sus.close_session(s2)
sketchy {
    yo gone = sus.run_in(s2, assemble([], [GHOST_OP, RETURN]))
} my_bad (e) {
    yap "caught:", e.flavor
}
yo r10 = sus.run_in(s, assemble([["str", "counter"]], [GET_GLOBAL, 0, 0, RETURN]))
yap r10["repr"]

// -- bad input ------------------------------------------------------------
sketchy {
    yo bad = sus.run_in(999, assemble([], [GHOST_OP, RETURN]))
} my_bad (e) {
    yap "caught:", e.flavor
}

sketchy {
    yo bad = sus.run_in("not an id", assemble([], [GHOST_OP, RETURN]))
} my_bad (e) {
    yap "caught:", e.flavor
}

sketchy {
    yo bad = sus.run_in(s, "not a stash")
} my_bad (e) {
    yap "caught:", e.flavor
}

yo bad_blob = sus.run_in(s, [1, 2, 3])
yap bad_blob["flavor"], bad_blob["code"]

sketchy {
    yo bad = sus.close_session("nope")
} my_bad (e) {
    yap "caught:", e.flavor
}

// Closing twice, or closing something never opened, is a no-op.
yo c1 = sus.close_session(s)
yo c2 = sus.close_session(s)
yo c3 = sus.close_session(1234)
yap c1, c2, c3
yap "done"
