// tests/lang/stdlib/vault_password.funny -- storing a password so that a
// stolen database is not a stolen list of passwords. The parameters travel
// with the hash, so raising the default iteration count later does not
// invalidate anybody's existing password.
gimme vault
gimme yapper

yo stored = vault.hash_password("hunter2")
yap yapper.starts_with(stored, "pbkdf2-sha256$600000$")
yap vault.check_password("hunter2", stored)
yap vault.check_password("hunter3", stored)

// A fresh salt every time, so two people with the same password do not have
// the same stored string.
yap vault.hash_password("hunter2") == stored

yo cheap = vault.hash_password("hunter2", 1000)
yap yapper.starts_with(cheap, "pbkdf2-sha256$1000$")
yap vault.check_password("hunter2", cheap)

// Anything malformed is simply "no". A login must not leak which part of it
// was wrong, and that includes "this record isn't a hash at all".
yap vault.check_password("hunter2", "")
yap vault.check_password("hunter2", "plaintext")
yap vault.check_password("hunter2", "pbkdf2-sha256$oops$AAAA$AAAA")
yap vault.check_password("hunter2", "pbkdf2-sha256$1000$not base64$AAAA")
