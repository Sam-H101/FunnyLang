// tests/lang/stdlib/vault_same_secret.funny -- comparing two secrets without
// telling an attacker how much of their guess was right. Every byte is looked
// at every time, so the comparison takes the same time whether the first byte
// differs or none of them do.
gimme vault
gimme blob

yap vault.same_secret("abc", "abc")
yap vault.same_secret("abc", "abd")
yap vault.same_secret("abc", "abcd")
yap vault.same_secret(blob.from_yap("abc"), "abc")
yap vault.same_secret("", "")
