!XRAY --tokens
Token(TEMPLATE, '`hello`' [('str', 'hello')], 1:1)
Token(NEWLINE, '\n', 1:8)
Token(TEMPLATE, '`yo {name}`' [('str', 'yo '), ('tokens', [Token(IDENT, 'name' 'name', 2:6), Token(EOF, '', 2:10)])], 2:1)
Token(NEWLINE, '\n', 2:12)
Token(TEMPLATE, '`{a} and {b}`' [('tokens', [Token(IDENT, 'a' 'a', 3:3), Token(EOF, '', 3:4)]), ('str', ' and '), ('tokens', [Token(IDENT, 'b' 'b', 3:11), Token(EOF, '', 3:12)])], 3:1)
Token(NEWLINE, '\n', 3:14)
Token(TEMPLATE, '`{ {1: 2} }`' [('tokens', [Token(LBRACE, '{', 4:4), Token(INT, '1' 1, 4:5), Token(COLON, ':', 4:6), Token(INT, '2' 2, 4:8), Token(RBRACE, '}', 4:9), Token(EOF, '', 4:11)])], 4:1)
Token(NEWLINE, '\n', 4:13)
Token(TEMPLATE, '`\\{not a sub}`' [('str', '{not a sub}')], 5:1)
Token(NEWLINE, '\n', 5:15)
Token(TEMPLATE, '`a\\`b`' [('str', 'a`b')], 6:1)
Token(NEWLINE, '\n', 6:7)
Token(ELLIPSIS, '...', 7:1)
Token(IDENT, 'rest' 'rest', 7:4)
Token(NEWLINE, '\n', 7:8)
Token(IDENT, 'a' 'a', 8:1)
Token(AMP_AMP, '&&', 8:2)
Token(IDENT, 'b' 'b', 8:4)
Token(NEWLINE, '\n', 8:5)
Token(IDENT, 'a' 'a', 9:1)
Token(AMP, '&', 9:3)
Token(AMP, '&', 9:5)
Token(IDENT, 'b' 'b', 9:6)
Token(NEWLINE, '\n', 9:7)
Token(EOF, '', 10:1)
