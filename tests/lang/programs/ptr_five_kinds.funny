// Exercises all five place kinds a pointa can address (PLAN.md §3.10).

// 1. a local variable
bet bump_local() {
    yo n = 1
    yo p = &n
    *p += 1
    bounce n
}
yap bump_local()

// 2. a global
yo g = 10
bet bump_global() {
    yo p = &g
    *p += 1
}
bump_global()
yap g

// 3. a captured upvalue
bet make_bumper() {
    yo n = 100
    bet bumper() {
        yo p = &n
        *p += 1
        bounce n
    }
    bounce bumper
}
yo bumper = make_bumper()
yap bumper()
yap bumper()

// 4. a stash element
yo arr = [1, 2, 3]
yo pi = &arr[1]
*pi = 99
yap arr

// 5. a squad instance field
squad Cat {
    spawn(hp) {
        me.hp = hp
    }
}
yo c = Cat(5)
yo pf = &c.hp
*pf += 1
yap c.hp
