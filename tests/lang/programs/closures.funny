bet counter() {
    yo n = 0
    bet inc() {
        n = n + 1
        bounce n
    }
    bounce inc
}
yo c1 = counter()
yo c2 = counter()
yap c1()
yap c1()
yap c1()
yap c2()

bet make_adder(x) {
    bet adder(y) {
        bounce x + y
    }
    bounce adder
}
yo add5 = make_adder(5)
yo add10 = make_adder(10)
yap add5(1)
yap add10(1)

bet outer() {
    yo a = 1
    bet middle() {
        yo b = 2
        bet inner() {
            bounce a + b
        }
        bounce inner
    }
    bounce middle()
}
yap outer()()

// A closure capturing `x` and an `&x` taken in the same scope must share
// one box (PLAN.md §3.10) -- the same boxing machinery this exercises.
// Two globals stand in for "return a pair" since stash literals ([a, b])
// aren't in scope until N4.
yo captured_inc = ghost
yo captured_ptr = ghost
bet setup_aliasing() {
    yo n = 0
    captured_inc = lowkey () => { n += 1; bounce n }
    captured_ptr = &n
}
setup_aliasing()
yap captured_inc()
yap captured_inc()
yap *captured_ptr
*captured_ptr += 100
yap captured_inc()
