gimme filez

yo dir = filez.join_path("build", "n4", "filez_scratch")
filez.mkdir(dir)
yap filez.exists(dir)

yo f1 = filez.join_path(dir, "hello.txt")
yo written = filez.yeet_out(f1, "hello, world! 你好")
yap written

yo back = filez.slurp(f1)
yap back

yo appended = filez.append_to(f1, "!!!")
yap appended
yap filez.slurp(f1)

yo names = filez.list_dir(dir)
filez.yeet_out(filez.join_path(dir, "a.txt"), "a")
filez.yeet_out(filez.join_path(dir, "z.txt"), "z")
yap filez.list_dir(dir)

yo bytesFile = filez.join_path(dir, "data.bin")
yo n = filez.write_bytes(bytesFile, [0, 1, 2, 255, 128, 65])
yap n
yo readBack = filez.read_bytes(bytesFile)
yap readBack

// slurp is text mode: universal newlines, so a CRLF (or lone-CR) file reads
// back with plain "\n" line endings on every platform. write_bytes puts the
// exact bytes down so this is the same file everywhere, not a fixture whose
// line endings depend on how the repo was checked out. read_bytes is the
// escape hatch for anyone who wants the bytes as they really are.
yo crlfFile = filez.join_path(dir, "crlf.txt")
filez.write_bytes(crlfFile, [104, 105, 13, 10, 116, 104, 101, 114, 101, 13, 10])
yo crlfText = filez.slurp(crlfFile)
yap crlfText.how_thicc()
yap crlfText.contains("\r")
yap crlfText.split("\n")
yap filez.read_bytes(crlfFile).how_thicc()

yo crFile = filez.join_path(dir, "cr.txt")
filez.write_bytes(crFile, [97, 13, 98, 13, 99])
yo crText = filez.slurp(crFile)
yap crText.how_thicc()
yap crText.split("\n")
filez.obliterate(crlfFile)
filez.obliterate(crFile)

// is_dir / is_file: `exists` alone can't drive a recursive walk. Both are
// cap for a path that isn't there, rather than raising.
yap filez.is_dir(dir)
yap filez.is_file(dir)
yap filez.is_dir(f1)
yap filez.is_file(f1)
yap filez.is_dir(filez.join_path(dir, "nope"))
yap filez.is_file(filez.join_path(dir, "nope"))
sketchy {
    yap filez.is_dir(42)
} my_bad (e) {
    yap "caught:", e.flavor
}

yo abs1 = filez.abs_path(f1)
yap abs1.contains("hello.txt")

yap filez.dir_of("a/b/c.txt")
yap filez.dir_of("c.txt")
yap filez.dir_of("/a/b")
yap filez.dir_of("/a")
yap filez.base_of("a/b/c.txt")
yap filez.base_of("/a/b/")
yap filez.ext_of("a/b/c.tar.gz")
yap filez.ext_of("a/.hidden")
yap filez.ext_of("a/noext")
yap filez.join_path("a", "b", "c.txt")
yap filez.join_path("a/", "b")
yap filez.join_path("a", "/root", "b")

// join_path builds with the *OS* separator, and dir_of/base_of split on it
// again -- so this round trip holds on every platform even though the
// strings themselves differ between them.
yo built = filez.join_path("a", "b", "c.txt")
yap filez.dir_of(built) == filez.join_path("a", "b")
yap filez.base_of(built)
yap filez.ext_of(built)
yap filez.base_of(filez.join_path(filez.join_path("x", "y"), "z.md"))

sketchy {
    filez.slurp(filez.join_path(dir, "does_not_exist.txt"))
} my_bad (e) {
    yap "caught:", e.flavor
}

sketchy {
    filez.slurp(42)
} my_bad (e) {
    yap "caught:", e.flavor
}

filez.obliterate(filez.join_path(dir, "a.txt"))
filez.obliterate(filez.join_path(dir, "z.txt"))
filez.obliterate(filez.join_path(dir, "data.bin"))
filez.obliterate(f1)
yap filez.exists(f1)
filez.obliterate(dir)
yap filez.exists(dir)
