bet catch_it(fn) {
    sketchy {
        fn()
    } my_bad (e) {
        yap "caught:", e.flavor
    }
}

catch_it(lowkey () => {
    yo m = {"a": 1}
    yo p = &m["a"]
    bounce p + 1
})

catch_it(lowkey () => {
    bounce *ghost
})

catch_it(lowkey () => {
    yo x = 5
    bounce *x
})

catch_it(lowkey () => {
    yo m = {"a": 1}
    yo p = &m["a"]
    m.remove("a")
    bounce *p
})

catch_it(lowkey () => {
    yo arr = [1, 2, 3]
    yo p = &arr[2]
    arr.yoink()
    bounce *p
})
