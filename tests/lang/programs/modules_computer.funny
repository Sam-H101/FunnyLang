gimme computer

sketchy {
    computer.explode()
} my_bad (e) {
    yap "caught:", e.flavor
}

yo r = computer.ram()
yap what_is_it(r)
yap r >= 0

yo u = computer.uptime()
yap what_is_it(u)
yap u >= 0.0

yap what_is_it(computer.yeet_to_void())
yap what_is_it(computer.yeet_to_void(42))

yo b = computer.beep()
yap what_is_it(b)

yo c = computer.clear()
yap what_is_it(c)

sketchy {
    computer.blue_screen()
} my_bad (e) {
    yap "caught:", e.flavor
}
