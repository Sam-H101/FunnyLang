yo s = "héllo"
yap s
yap s[0]
yap s[1]
yap s[4]
yap s[-1]
yap s[-5]

yo emoji = "hi👋bye"
yap emoji
yap emoji[2]
yap emoji[-3]

grind c in s {
    yap c
}

yo count = 0
grind c in emoji {
    count = count + 1
}
yap count

yap s[1:3]
yap s[:2]
yap s[2:]
yap s[::-1]
yap emoji[::-1]
yap emoji[::2]

yap "café" == "café"
yap "café" == "cafe"
yap "café" < "cafz"
yap "é" in "héllo"
yap "z" in "héllo"

yo doubled = "ab" * 3
yap doubled
yo tripled_emoji = "👋" * 2
yap tripled_emoji
yo prefixed = 2 * "xy"
yap prefixed

yo concatenated = "héllo, " + "wörld"
yap concatenated

yo mixed = ["plain", "héllo", "hi👋bye", "quote\"inside"]
yap mixed

yo ascii_only = "plain text"
yap ascii_only[3]
yap ascii_only[::-1]
