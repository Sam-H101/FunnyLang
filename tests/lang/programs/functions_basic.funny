bet add(a, b) {
    bounce a + b
}
yap add(2, 3)

bet greet(name, greeting = "hello") {
    bounce greeting + ", " + name
}
yap greet("world")
yap greet("world", "hi")

bet fact(n) {
    sus (n <= 1) {
        bounce 1
    }
    bounce n * fact(n - 1)
}
yap fact(10)
yap fact(30)

bet fib(n) {
    sus (n < 2) {
        bounce n
    }
    bounce fib(n - 1) + fib(n - 2)
}
yap fib(15)

bet no_return() {
    yo x = 1
}
yap no_return()

bet early_return(n) {
    sus (n < 0) {
        bounce "negative"
    }
    bounce "non-negative"
}
yap early_return(-5)
yap early_return(5)
