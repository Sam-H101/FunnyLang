// The primitives selfhost/cli.funny needs so native/main.c can shrink to a
// loader (NATIVE_PLAN.md N8 task 6). None of these is CLI logic -- they are
// the platform I/O a CLI written in the language cannot otherwise reach.

gimme filez
gimme computer
gimme yapper

// -- computer.env ---------------------------------------------------------
// A name nothing sets is the half worth pinning. Asking about PATH would be
// the obvious other half, and it is deliberately not here: CI runs part of
// this corpus under `env -i`, where PATH genuinely is unset, and a golden
// whose answer depends on the ambient environment is not a golden.
yap computer.env("FUNNY_DEFINITELY_NOT_SET_XYZZY")
yap computer.env("FUNNY_DEFINITELY_NOT_SET_XYZZY", "fallback")
yap computer.env("FUNNY_DEFINITELY_NOT_SET_XYZZY", 42)
sketchy {
    yo bad = computer.env(42)
} my_bad (e) {
    yap "caught:", e.flavor
}

// -- computer.exe_path ----------------------------------------------------
// The two implementations answer with different things by nature -- the
// native runtime with the `funny` binary, this one with the entry script --
// so only the properties are compared, the way computer.flex() is.
yo exe = computer.exe_path()
yap what_is_it(exe)
yap exe.how_thicc() > 0
// `filez.exists(exe)` is deliberately not asked. It is a property of the
// host process rather than of the language: the reference answered `fax`
// when run as a script and `cap` when run from stdin, because it reported
// argv[0]. The native runtime always names a real file, so the question is
// only interesting where the answer is unstable.
yap filez.is_dir(filez.dir_of(exe))

// -- filez.temp_file ------------------------------------------------------
yo tmp = filez.temp_file("cliprims")
yap what_is_it(tmp)
yap filez.exists(tmp)
yap filez.is_file(tmp)
// Three characters, not the whole prefix: Windows' GetTempFileName truncates
// a prefix to three, so `temp_file("cliprims")` yields `cliXXXX.tmp` there
// and `cliprimsXXXX` elsewhere. The part that matters -- the caller's prefix
// reaching the name at all -- holds on both.
yap yapper.contains(filez.base_of(tmp), "cli")
// Two calls never collide.
yo tmp2 = filez.temp_file("cliprims")
yap tmp != tmp2

sketchy {
    yo bad = filez.temp_file(42)
} my_bad (e) {
    yap "caught:", e.flavor
}

// -- filez.append_bytes ---------------------------------------------------
filez.write_bytes(tmp, [1, 2, 3])
yap filez.append_bytes(tmp, [4, 5])
yap filez.read_bytes(tmp)
yap filez.append_bytes(tmp, [])
yap filez.read_bytes(tmp)
// Bytes are bytes: no newline translation on the way in or out, unlike the
// text-mode slurp.
filez.write_bytes(tmp, [65, 13, 10, 66])
filez.append_bytes(tmp, [13, 67])
yap filez.read_bytes(tmp)
yap filez.slurp(tmp).how_thicc()

sketchy {
    filez.append_bytes(tmp, "not a stash")
} my_bad (e) {
    yap "caught:", e.flavor
}
sketchy {
    filez.append_bytes(filez.join_path(tmp2, "nope", "deeper"), [1])
} my_bad (e) {
    yap "caught:", e.flavor
}

// -- filez.make_executable ------------------------------------------------
// A no-op on Windows and a chmod everywhere else, so the observable part is
// that it succeeds and leaves the file alone.
filez.write_bytes(tmp, [35, 33, 10])
filez.make_executable(tmp)
yap filez.read_bytes(tmp)
yap filez.exists(tmp)
sketchy {
    filez.make_executable(42)
} my_bad (e) {
    yap "caught:", e.flavor
}

filez.obliterate(tmp)
filez.obliterate(tmp2)
yap filez.exists(tmp)
yap "done"
