bet swap(a, b) {
    yo t = *a
    *a = *b
    *b = t
}
yo x = 1
yo y = 2
swap(&x, &y)
yap x, y

bet glow_up(stat) {
    *stat += 100
}
yo clout = 0
glow_up(&clout)
yap clout

yo g = 10
bet bump_global() {
    yo pg = &g
    *pg += 5
}
bump_global()
yap g

bet make_bumper() {
    yo n = 100
    bet bumper() {
        yo p = &n
        *p += 1
        bounce n
    }
    bounce bumper
}
yo bumper = make_bumper()
yap bumper()
yap bumper()

// pointer to pointer
yo v = 5
yo p1 = &v
yo p2 = &p1
yap **p2
**p2 = 42
yap v

// what_is_it()/to_yap() are stdlib builtins (funnylang/stdlib/builtins.py)
// -- not bound to any native function yet, since the stdlib is N5's job.
// pointa's .deref()/.set()/.valid()/.where() method forms need INVOKE
// (obj.method(args)), which isn't in scope until N4 -- see
// NATIVE_PLAN.md §9's N3 entry. The core &/* functionality above is what
// N3 task 7 actually asks for.
