// PLAN.md M11's 10,000-frame recursion cap: infinite recursion must raise
// TooDeepBro cleanly, not smash the stack. Caught here so both VMs' exit
// codes/output can be compared, not just their happy paths.
bet recurse(n) {
    bounce recurse(n + 1)
}
sketchy {
    recurse(0)
} my_bad (e) {
    yap "caught:", e.flavor
}
yap "still alive"
