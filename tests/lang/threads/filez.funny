// tests/lang/threads/filez.funny -- RUNTIME_PLAN.md R0: `filez` from eight interns at
// once. The same work runs on this thread first; every intern's answer must
// match it. A process-wide scratch buffer, a shared generator or a
// non-reentrant C library call shows up here as a mismatch -- and, under
// ThreadSanitizer in CI, as a report.
gimme { crew_matches, CREW } from "workers/crew.funny"
gimme { work_filez } from "workers/filez_work.funny"

yap "filez, eight interns at once, answers matching one thread:", crew_matches("filez", work_filez), "of", CREW
