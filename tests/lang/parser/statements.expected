!XRAY --ast
(program (yo bare ghost) (yo initialized 10) (deadass PI 3.14159) (bet greet (name greeting) (block (bounce name))) (bet sum_all ( ...rest) (block (bounce rest))) (sus (> x 100) (block (yap "big")) (kinda_sus (> x 10) (block (yap "medium"))) (nah (block (yap "smol")))) (bruh (> x 0) (block (-= x 1))) (grind i from 10 to 0 step (- 2) (block (yap i))) (grind i from 0 to 10 (block (yap i))) (grind item in (stash "a" "b") (block (yap item))) (bruh fax (block (sus x (block (bail))) (sus y (block (nvm))))) (bet bare_return () (block (bounce ghost))) (bet valued_return () (block (bounce (+ 1 2)))) (sketchy (block (chuck "oops")) (my_bad e (block (yap "caught:" (get e message)))) (regardless (block (yap "cleanup")))) (chuck "you fumbled it") (gimme path "mathstuff.funny") (gimme path "./util/helpers.funny" as helpers) (gimme path "mathstuff.funny" names(double,TAU)) (gimme stdlib "mafs") (gimme stdlib "rizz" as luck) (flex (bet add (a b) (block (bounce (+ a b))))) (flex (deadass TAU 6.28318)) (yap x y "three things") (yap "hi") (mumble "no newline") (vibe) (bet counter () (block (yo n 0) (bounce (lambda () (block (+= n 1) (bounce n)))))))
