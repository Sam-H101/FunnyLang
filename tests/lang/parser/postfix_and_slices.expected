!XRAY --ast
(program (yo arr (stash 1 2 3)) (yo s "hello") (yo chain (get (index (call (get a b) 1) 2) c)) (yo trailing (call f 1 2 3)) (yo multiline (call f 1 2)) (yo s1 (slice arr 1 3 ghost)) (yo s2 (slice arr ghost 2 ghost)) (yo s3 (slice arr 2 ghost ghost)) (yo s4 (slice s ghost ghost (- 1))) (yo s5 (index arr (- 1))))
